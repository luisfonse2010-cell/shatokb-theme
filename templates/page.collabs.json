shopify:\/\/apps\/collabs\/blocks\/application-page\/54758706-9f25-4fa9-a553-64720a4c998b","settings":{"heading":"Join our Ambassador Program today","show_square_logo":true,"show_partnership_info":true,"button_text":"","number_of_images":"2","logo_position":"above","corner_style":"square","button_background_color":"#000000","button_label_color":"#ffffff","link_color":"#2c6ecb"}}},"block_order":["collabs_application_page_cMwQX6"],"settings":{"include_margins":false}},"custom_liquid_VqEJAh":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"faq-section\">\n  <h2>Have any questions?<\/h2>\n  <p>Check out our frequently asked questions below or email us at <a href=\"mailto:cs@sfwellnessllc.com\">cs@sfwellnessllc.com<\/a> with any other questions.<\/p>\n  \n  <div class=\"faq-item\">\n    <button class=\"faq-question\">What referral tools do you offer?<\/button>\n    <div class=\"faq-answer\">We offer the most referral tools on the market such as general referral links, promo codes, and ambassador eshops.<\/div>\n  <\/div>\n  \n  <div class=\"faq-item\">\n    <button class=\"faq-question\">Is this an MLM?<\/button>\n    <div class=\"faq-answer\">No, we are not a Multi Level Marketing (MLM) scheme. We are simply a fun way to refer your friends and family.<\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-question\">When do I receive my commissions?<\/button>\n    <div class=\"faq-answer\">Commission payments are disbursed on the 15th of the month. Just make sure to have your payment method connected such as Paypal or Venmo.<\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-question\">Do I have to file taxes for any income earned here?<\/button>\n    <div class=\"faq-answer\">Yes. You must file a 1099 tax form with the total commissions earned from our program.<\/div>\n  <\/div>\n  \n  <div class=\"faq-item\">\n    <button class=\"faq-question\">Is it FREE to join the Program?<\/button>\n    <div class=\"faq-answer\">Yes, it's completely free. All you have to do is sign up and share your referral links on social media.<\/div>\n  <\/div>\n  \n  <div class=\"faq-item\">\n    <button class=\"faq-question\">What are Ambassador e-shops?<\/button>\n    <div class=\"faq-answer\">Every brand ambassador who signs up gets their very own personalized e-shop to share their favorite products, personal discount codes, and more. It's perfect for sales on TikTok, Instagram, and other social media platforms when recommending products.<\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-question\">What if a customer needs support?<\/button>\n    <div class=\"faq-answer\">Let us do all the work! If a customer asks you for support, direct them to our support page or provide our support email.<\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-question\">How will my customers receive their products?<\/button>\n    <div class=\"faq-answer\">You don’t have to do a thing. Once the customer makes a purchase, we will receive the order and ensure timely delivery.<\/div>\n  <\/div>\n<\/div>\n\n<style>\n  .faq-section {\n    max-width: 800px;\n    margin: auto;\n  }\n  .faq-question {\n    width: 100%;\n    padding: 10px;\n    text-align: left;\n    background: #f5f5f5;\n    border: none;\n    cursor: pointer;\n    font-size: 16px;\n  }\n  .faq-answer {\n    display: none;\n    padding: 10px;\n    background: #fff;\n    border: 1px solid #ddd;\n  }\n  .faq-item {\n    margin-bottom: 10px;\n  }\n<\/style>\n\n<script>\n  document.querySelectorAll('.faq-question').forEach(button => {\n    button.addEventListener('click', () => {\n      const answer = button.nextElementSibling;\n      answer.style.display = answer.style.display === 'block' ? 'none' : 'block';\n    });\n  });\n<\/script>"}}},"order":["rich_text_wJn68X","collabs","custom_press_banner_rrEt3e","custom_press_banner_dDAA8h","custom_service_block_TMVtBA","apps_AdBtJP","custom_liquid_VqEJAh"]}