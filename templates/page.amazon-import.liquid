function shatoFillForm(p) {
  document.getElementById('f-img').value = p.image || '';
  document.getElementById('f-asin').value = p.asin || '';
  document.getElementById('f-title-amazon').value = p.titleAmazon || '';
  document.getElementById('f-title-store').value = p.titleStore || '';
  document.getElementById('f-desc').value = p.description || '';
  document.getElementById('f-category-amazon').value = p.categoryAmazon || '';
  document.getElementById('f-nicho').value = p.nicho || '';
  document.getElementById('f-price-amazon').value = p.priceAmazon || '';
  document.getElementById('f-shipping').value = p.shipping || '0';
  document.getElementById('f-stock').value = p.stock || '0';
  document.getElementById('f-stock-min').value = p.stockMin || '2';
  const cost = (parseFloat(p.priceAmazon)||0) + (parseFloat(p.shipping)||0);
  const margin = cost > 0 ? Math.round(((p.priceStore - cost) / p.priceStore) * 100) : SHATO_CONFIG.defaultMargin;
  document.getElementById('f-margin').value = margin;
  shatoUpdatePreview();
  shatoUpdateAmazonLinks();
