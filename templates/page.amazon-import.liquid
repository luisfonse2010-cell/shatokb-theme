// ── SHOPIFY API ──
async function shatoPublishToShopify(prod) {
  shatoShowNotif('⏳ Publicando en Shopify...', 'success');
  const isKB   = prod.nicho === 'kbeauty';
  const domain = SHATO_CONFIG.shopifyDomain || 'shatokb.myshopify.com';
  const token  = SHATO_CONFIG.shopifyToken;
  const tags   = ['nicho:' + prod.nicho, 'asin:' + prod.asin];
  if (!isKB && SHATO_CONFIG.autoHidden) tags.push('hidden');
  if (isKB) { tags.push('kbeauty'); if (prod.koiCategoria) tags.push('categoria:' + prod.koiCategoria); if (prod.koiTier) tags.push('tier:' + prod.koiTier); if (prod.koiArchetype) tags.push('archetype:' + prod.koiArchetype.replace(/ /g, '_')); if (prod.koiSafety) tags.push('safety:' + prod.koiSafety); if (prod.koiPhase) tags.push('phase:' + prod.koiPhase); if (prod.koiNivel) tags.push('nivel_usuario:' + prod.koiNivel); if (prod.momento) tags.push('momento:' + prod.momento); if (prod.ingredients) prod.ingredients.forEach(i => tags.push('ingrediente:' + i)); if (prod.fit) Object.entries(prod.fit).forEach(([k,v]) => { if (v >= 0.5) tags.push('fit:' + k); }); }
  const body = { product:{ title:prod.titleStore||prod.titleAmazon, body_html:prod.description||'', vendor:isKB?'K-Beauty':'SHATO Import', product_type:prod.koiCategoria||prod.nicho||'', tags:tags.join(', '), status:'active', variants:[{ price:prod.priceStore.toFixed(2), sku:prod.asin||'', inventory_quantity:prod.stock||0, inventory_management:'shopify' }], images:prod.image?[{src:prod.image}]:[] } };
  try {
    const res = await fetch('https://' + domain + '/admin/api/2024-01/products.json', { method:'POST', headers:{ 'X-Shopify-Access-Token':token, 'Content-Type':'application/json' }, body:JSON.stringify(body) });
    if (res.ok) {
      const data = await res.json();
      const idx = SHATO_PRODUCTS.findIndex(p => p.id === prod.id);
      if (idx !== -1) {
        SHATO_PRODUCTS[idx].status = 'published';
        SHATO_PRODUCTS[idx].shopifyId = data.product?.id;
        SHATO_PRODUCTS[idx].publishedAt = new Date().toISOString();
      }
      shatoSaveData(); shatoRenderDashboard(); shatoRenderPendientes();
      const nichoInfoS = SHATO_NICHO_MAP[prod.nicho] || null;
      shatoShowNotifWithAction(
        '✅ Publicado en Shopify' + (isKB ? ' 🌸 K-Beauty' : ' (multi-nicho)'),
        nichoInfoS ? 'Ver en ' + nichoInfoS.label + ' →' : 'Ver →',
        () => nichoInfoS ? shatoShowNicho(prod.nicho) : shatoShowTab('pendientes')
      );
    } else { shatoShowNotif('❌ Error al publicar — verificá el token API', 'error'); }
  } catch (e) { shatoShowNotif('❌ Error de red al conectar con Shopify', 'error'); }
}

