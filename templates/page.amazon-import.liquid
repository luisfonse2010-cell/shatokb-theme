function shatoClearForm() {
  ['f-img','f-asin','f-title-amazon','f-title-store','f-desc','f-category-amazon','f-price-amazon','f-shipping','f-stock','f-stock-min'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  document.getElementById('f-nicho').value = '';
