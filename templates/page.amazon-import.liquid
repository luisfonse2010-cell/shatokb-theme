function shatoCalcPrice() {
  const amazon   = parseFloat(document.getElementById('f-price-amazon').value) || 0;
  const shipping = parseFloat(document.getElementById('f-shipping').value) || 0;
  const margin   = parseFloat(document.getElementById('f-margin').value) || 35;
  const cost     = amazon + shipping;
  const price    = margin > 0 ? cost / (1 - margin / 100) : cost;
  const ganancia = price - cost;
  const comRate  = document.getElementById('f-nicho').value === 'kbeauty' ? 0.10 : 0.03;
  const comision = amazon * comRate;
  document.getElementById('calc-costo').textContent    = '$' + cost.toFixed(2);
  document.getElementById('calc-precio').textContent   = '$' + price.toFixed(2);
  document.getElementById('calc-ganancia').textContent = '$' + ganancia.toFixed(2);
  document.getElementById('calc-comision').textContent = '$' + comision.toFixed(2) + ' (' + Math.round(comRate * 100) + '%)';
}

function shatoBuildAffiliateLink(asin) {
  if (!asin) return '#';
  const tag = SHATO_CONFIG.amazonTag || '';
  const base = 'https://www.amazon.com/dp/' + asin;
  return tag ? base + '?tag=' + tag : base;
}

function shatoUpdateAmazonLinks() {
  const asin = document.getElementById('f-asin').value.trim();
  const normalLink = asin ? 'https://www.amazon.com/dp/' + asin : '#';
  const affLink    = shatoBuildAffiliateLink(asin);
  document.getElementById('f-amazon-link').href = normalLink;
  document.getElementById('f-amazon-affiliate-link').href = affLink;
}

function shatoUpdatePreview() {
