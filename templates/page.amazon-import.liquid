              <div class="fit-item"><div class="fit-label"><span>Piel Seca</span><span id="fit-dry-val">80%</span></div><input type="range" class="fit-slider" id="fit-dry" min="0" max="100" value="80" oninput="document.getElementById('fit-dry-val').textContent=this.value+'%'"></div>
              <div class="fit-item"><div class="fit-label"><span>Piel Grasa</span><span id="fit-oily-val">60%</span></div><input type="range" class="fit-slider" id="fit-oily" min="0" max="100" value="60" oninput="document.getElementById('fit-oily-val').textContent=this.value+'%'"></div>
              <div class="fit-item"><div class="fit-label"><span>Mixta</span><span id="fit-combo-val">70%</span></div><input type="range" class="fit-slider" id="fit-combo" min="0" max="100" value="70" oninput="document.getElementById('fit-combo-val').textContent=this.value+'%'"></div>
              <div class="fit-item"><div class="fit-label"><span>Sensible</span><span id="fit-sens-val">80%</span></div><input type="range" class="fit-slider" id="fit-sens" min="0" max="100" value="80" oninput="document.getElementById('fit-sens-val').textContent=this.value+'%'"></div>
              <div class="fit-item"><div class="fit-label"><span>Acné</span><span id="fit-acne-val">50%</span></div><input type="range" class="fit-slider" id="fit-acne" min="0" max="100" value="50" oninput="document.getElementById('fit-acne-val').textContent=this.value+'%'"></div>
              <div class="fit-item"><div class="fit-label"><span>Manchas</span><span id="fit-pig-val">70%</span></div><input type="range" class="fit-slider" id="fit-pig" min="0" max="100" value="70" oninput="document.getElementById('fit-pig-val').textContent=this.value+'%'"></div>
            </div>
          </div>
          <div style="margin-bottom:16px">
            <label class="form-label">Ingredientes principales</label>
            <div style="display:flex;gap:8px;margin-bottom:8px">
              <input type="text" class="form-input" id="ing-input" placeholder="ej: niacinamide..." style="flex:1" onkeydown="if(event.key==='Enter')shatoAddIngredient()">
              <button class="btn btn-outline btn-sm" onclick="shatoAddIngredient()">+ Agregar</button>
            </div>
            <div class="chip-selector" style="margin-bottom:8px">
              <div class="chip" onclick="shatoAddIngredientDirect('niacinamide')">Niacinamide</div>
              <div class="chip" onclick="shatoAddIngredientDirect('hyaluronic_acid')">Hyaluronic Acid</div>
              <div class="chip" onclick="shatoAddIngredientDirect('retinol')">Retinol</div>
              <div class="chip" onclick="shatoAddIngredientDirect('centella_asiatica')">Centella Asiatica</div>
              <div class="chip" onclick="shatoAddIngredientDirect('snail_mucin')">Snail Mucin</div>
              <div class="chip" onclick="shatoAddIngredientDirect('vitamin_c')">Vitamin C</div>
              <div class="chip" onclick="shatoAddIngredientDirect('ceramides')">Ceramides</div>
              <div class="chip" onclick="shatoAddIngredientDirect('salicylic_acid')">Salicylic Acid</div>
              <div class="chip" onclick="shatoAddIngredientDirect('peptides')">Peptides</div>
              <div class="chip" onclick="shatoAddIngredientDirect('aha')">AHA</div>
              <div class="chip" onclick="shatoAddIngredientDirect('bha')">BHA</div>
              <div class="chip" onclick="shatoAddIngredientDirect('panthenol')">Panthenol</div>
            </div>
            <div class="ingredients-list" id="ingredients-list"></div>
          </div>
          <div>
            <label class="form-label">Score KOI estimado</label>
            <div style="display:flex;align-items:center;gap:12px">
              <div class="koi-score-bar" style="flex:1"><div class="koi-score-fill" id="koi-score-fill" style="width:65%"></div></div>
              <span id="koi-score-text" style="font-size:18px;font-weight:800;color:#e879f9">65/100</span>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline" onclick="shatoCloseModal('captureModal')">Cancelar</button>
        <button class="btn btn-danger btn-sm" onclick="shatoRejectProduct()" id="btn-reject" style="display:none"><i class="fas fa-times"></i> Rechazar</button>
        <button class="btn btn-success" onclick="shatoPublishProduct()"><i class="fas fa-rocket"></i> Publicar en Shopify</button>
      </div>
    </div>
  </div>

  <!-- NOTIFICACIONES -->
  <div class="notif-container" id="notif-container"></div>

</div><!-- /shato-app -->

<script>
'use strict';

// ── CONFIG ──
let SHATO_CONFIG = {
  shopifyToken: '',
  shopifyDomain: 'shatokb.myshopify.com',
  amazonTag: '',
  defaultMargin: 35,
  minMargin: 20,
  hideMultinichos: true,
  autoHidden: true
};

let SHATO_PRODUCTS = [];
let SHATO_DESPACHOS = [];
let SHATO_INGREDIENTS = [];
let shatoEditingId = null;

const SHATO_NICHO_MAP = {
  kbeauty:{ label:'K-Beauty', emoji:'🌸' }, electronica:{ label:'Electrónica', emoji:'💻' },
  hogar:{ label:'Hogar & Cocina', emoji:'🏠' }, herramientas:{ label:'Herramientas', emoji:'🔧' },
  deportes:{ label:'Deportes', emoji:'⚽' }, bebes:{ label:'Bebés & Niños', emoji:'👶' },
  mascotas:{ label:'Mascotas', emoji:'🐾' }, salud:{ label:'Salud', emoji:'🏥' },
  otros:{ label:'Otros', emoji:'📦' }
};

const SHATO_SUBCATEGORIAS = {
  cleanser:['cleanser_foam','cleanser_oil','cleanser_balm','cleanser_gel','cleanser_micellar'],
  toner:['toner_hydrating','toner_exfoliating','toner_brightening','toner_calming'],
  serum:['serum_niacinamide','serum_vitamin_c','serum_retinol','serum_brightening','serum_antiaging','serum_hydrating','serum_barrier','serum_acne'],
  moisturizer:['moisturizer_gel','moisturizer_cream','moisturizer_balm','moisturizer_oil'],
  spf:['spf_chemical','spf_physical','spf_hybrid'],
  eye:['eye_cream','eye_serum','eye_patch'],
  mask:['mask_sheet','mask_sleeping','mask_clay','mask_wash_off'],
  essence:['essence_hydrating','essence_ferment','essence_brightening'],
  ampoule:['ampoule_concentrated','ampoule_brightening','ampoule_antiaging'],
  mist:['mist_hydrating','mist_setting','mist_calming']
};

const SHATO_KB_KEYWORDS = ['beauty','skin care','skincare','serum','moisturizer','cleanser','toner','spf','sunscreen','essence','ampoule','korean','k-beauty','facial','face cream','eye cream','mask','exfoliant'];

// ── INIT ──
function shatoInit() {
  shatoLoadConfig();
  shatoLoadData();
  shatoRenderDashboard();
  shatoUpdateSubcategorias();
}

function shatoLoadConfig() {
  const saved = localStorage.getItem('shato_config');
  if (saved) SHATO_CONFIG = { ...SHATO_CONFIG, ...JSON.parse(saved) };
  document.getElementById('cfg-shopify-token').value = SHATO_CONFIG.shopifyToken || '';
  document.getElementById('cfg-shopify-domain').value = SHATO_CONFIG.shopifyDomain || 'shatokb.myshopify.com';
  document.getElementById('cfg-amazon-tag').value = SHATO_CONFIG.amazonTag || '';
  document.getElementById('cfg-default-margin').value = SHATO_CONFIG.defaultMargin || 35;
  document.getElementById('cfg-min-margin').value = SHATO_CONFIG.minMargin || 20;
  document.getElementById('cfg-hide-multinichos').checked = SHATO_CONFIG.hideMultinichos !== false;
  document.getElementById('cfg-auto-hidden').checked = SHATO_CONFIG.autoHidden !== false;
  document.getElementById('f-margin').value = SHATO_CONFIG.defaultMargin || 35;
}

function shatoSaveConfig() {
  SHATO_CONFIG.shopifyToken  = document.getElementById('cfg-shopify-token').value.trim();
  SHATO_CONFIG.shopifyDomain = document.getElementById('cfg-shopify-domain').value.trim();
  SHATO_CONFIG.amazonTag     = document.getElementById('cfg-amazon-tag').value.trim();
  SHATO_CONFIG.defaultMargin = parseInt(document.getElementById('cfg-default-margin').value) || 35;
  SHATO_CONFIG.minMargin     = parseInt(document.getElementById('cfg-min-margin').value) || 20;
  SHATO_CONFIG.hideMultinichos = document.getElementById('cfg-hide-multinichos').checked;
  SHATO_CONFIG.autoHidden    = document.getElementById('cfg-auto-hidden').checked;
  localStorage.setItem('shato_config', JSON.stringify(SHATO_CONFIG));
  shatoShowNotif('✅ Configuración guardada', 'success');
}

function shatoLoadData() {
  const saved = localStorage.getItem('shato_products');
  if (saved) SHATO_PRODUCTS = JSON.parse(saved);
  const savedD = localStorage.getItem('shato_despachos');
  if (savedD) SHATO_DESPACHOS = JSON.parse(savedD);
}

function shatoSaveData() {
  localStorage.setItem('shato_products', JSON.stringify(SHATO_PRODUCTS));
  localStorage.setItem('shato_despachos', JSON.stringify(SHATO_DESPACHOS));
}

// ── TABS ──
function shatoShowTab(tab) {
  document.querySelectorAll('#shato-app .tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('#shato-app .sidebar-item').forEach(i => i.classList.remove('active'));
  const el = document.getElementById('tab-' + tab);
  if (el) el.classList.add('active');
  const titles = { dashboard:'📊 Dashboard', pendientes:'📥 Productos Pendientes', despachos:'🚚 Centro de Despachos', inventario:'📦 Control de Inventario', config:'⚙️ Configuración' };
  document.getElementById('topbarTitle').textContent = titles[tab] || tab;
  if (tab === 'dashboard')  shatoRenderDashboard();
  if (tab === 'pendientes') shatoRenderPendientes();
  if (tab === 'inventario') shatoRenderInventario();
  if (tab === 'despachos')  shatoRenderDespachos();
}

function shatoShowNicho(nicho) {
  document.querySelectorAll('#shato-app .tab-content').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-nicho').classList.add('active');
  const n = SHATO_NICHO_MAP[nicho] || { label: nicho, emoji: '📦' };
  document.getElementById('nicho-title').textContent = n.emoji + ' ' + n.label;
  document.getElementById('nicho-sub').textContent = 'Todos los productos de este nicho';
  document.getElementById('topbarTitle').textContent = n.emoji + ' ' + n.label;
  shatoRenderNicho(nicho);
}

// ── RENDER ──
function shatoRenderDashboard() {
  const total      = SHATO_PRODUCTS.length;
  const publicados = SHATO_PRODUCTS.filter(p => p.status === 'published').length;
  const pendientes = SHATO_PRODUCTS.filter(p => p.status === 'pending').length;
  const despachos  = SHATO_DESPACHOS.filter(d => d.status === 'pending').length;
  document.getElementById('stat-total').textContent      = total;
  document.getElementById('stat-publicados').textContent = publicados;
  document.getElementById('stat-pendientes').textContent = pendientes;
  document.getElementById('stat-despachos').textContent  = despachos;
  document.getElementById('badge-pendientes').textContent = pendientes;
  document.getElementById('badge-despachos').textContent  = despachos;
  Object.keys(SHATO_NICHO_MAP).forEach(n => {
    const count = SHATO_PRODUCTS.filter(p => p.nicho === n).length;
    const el = document.getElementById('badge-' + n);
    if (el) el.textContent = count;
  });
  const nichoSummary = document.getElementById('nicho-summary');
  nichoSummary.innerHTML = Object.entries(SHATO_NICHO_MAP).map(([key, val]) => {
    const count = SHATO_PRODUCTS.filter(p => p.nicho === key).length;
    return '<div class="nicho-card" onclick="shatoShowNicho(\'' + key + '\')">'
      + '<div class="nicho-emoji">' + val.emoji + '</div>'
      + '<div class="nicho-name">' + val.label + '</div>'
      + '<div class="nicho-count">' + count + ' producto' + (count !== 1 ? 's' : '') + '</div></div>';
  }).join('');
  const urgentes = SHATO_DESPACHOS.filter(d => d.status === 'pending').slice(0, 3);
  const dashDisp = document.getElementById('dashboard-despachos');
  if (urgentes.length === 0) {
    dashDisp.innerHTML = '<div class="empty-state" style="padding:40px"><i class="fas fa-truck"></i><h3>Sin despachos urgentes</h3><p>Cuando tengas ventas aparecerán aquí</p></div>';
  } else {
    dashDisp.innerHTML = urgentes.map(d => shatoRenderDespachoCard(d)).join('');
  }
}

function shatoRenderPendientes() {
  const pending = SHATO_PRODUCTS.filter(p => p.status === 'pending');
  const grid = document.getElementById('pendientes-grid');
  if (pending.length === 0) {
    grid.innerHTML = '<div class="empty-state" style="grid-column:1/-1;padding:60px"><i class="fas fa-inbox"></i><h3>No hay productos pendientes</h3><p>Usá la extensión Chrome en Amazon para capturar productos</p></div>';
    return;
  }
  grid.innerHTML = pending.map(p => shatoRenderProductCard(p)).join('');
}

function shatoRenderNicho(nicho) {
  const prods = SHATO_PRODUCTS.filter(p => p.nicho === nicho);
  const grid  = document.getElementById('nicho-grid');
  if (prods.length === 0) {
    grid.innerHTML = '<div class="empty-state" style="grid-column:1/-1;padding:60px"><i class="fas fa-box-open"></i><h3>Sin productos en este nicho</h3><p>Capturá productos de Amazon para agregarlos</p></div>';
    return;
  }
  grid.innerHTML = prods.map(p => shatoRenderProductCard(p)).join('');
}

function shatoRenderProductCard(p) {
  const isKB   = p.nicho === 'kbeauty';
  const isPending = p.status === 'pending';
  const margin = p.priceAmazon > 0 ? Math.round(((p.priceStore - p.priceAmazon) / p.priceStore) * 100) : 0;
  const afLink = shatoBuildAffiliateLink(p.asin);
  const statusBadge = isPending
    ? '<span class="tag" style="color:#fbbf24;border-color:#92400e;background:rgba(146,64,14,0.15)">⏳ Pendiente revisión</span>'
    : '<span class="tag core" style="color:#2ade80;border-color:#065f46;background:rgba(6,95,70,0.2)">✅ Publicado</span>';
  const nichoLabel = isKB
    ? '<span class="tag kbeauty">🌸 K-Beauty</span>'
    : (p.nicho ? '<span class="tag nicho">' + (SHATO_NICHO_MAP[p.nicho]?.emoji||'📦') + ' ' + (SHATO_NICHO_MAP[p.nicho]?.label||p.nicho) + '</span>' : '<span class="tag" style="color:#6b6b8a">📦 Sin nicho</span>');

  // Barra de accciones según estado
  let actions = '<a href="' + afLink + '" target="_blank" class="btn btn-amazon btn-sm" style="text-decoration:none"><i class="fab fa-amazon"></i> Amazon</a>'
    + '<button class="btn btn-outline btn-sm" onclick="shatoEditProduct(\'' + p.id + '\')"><i class="fas fa-edit"></i> Ver detalle</button>';
  if (isPending) {
    actions += '<button class="btn btn-success btn-sm" onclick="shatoQuickPublish(\'' + p.id + '\')" style="background:#6c63ff;border-color:#6c63ff"><i class="fas fa-rocket"></i> Publicar</button>';
    actions += '<button class="btn btn-sm" onclick="shatoRejectById(\'' + p.id + '\')" style="background:rgba(244,63,94,0.15);border:1px solid #f43f5e;color:#f43f5e" title="Descartar"><i class="fas fa-trash"></i></button>';
  }

  // Card con borde color según estado
  const cardBorder = isPending ? 'border-left:3px solid #6c63ff' : 'border-left:3px solid #2ade80';

  return '<div class="product-card" style="' + cardBorder + ';cursor:default">'
    + (p.image ? '<img class="product-card-img" src="' + p.image + '" alt="" onerror="this.style.display=\'none\'" style="cursor:pointer" onclick="shatoEditProduct(\'' + p.id + '\')">' : '')
    + '<div class="product-card-body">'
    + '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:4px">'
    + '<div class="product-card-asin" style="font-size:10px;color:#6b6b8a">ASIN: ' + (p.asin || '—') + '</div>'
    + statusBadge
    + '</div>'
    + '<div class="product-card-title" style="cursor:pointer;margin-bottom:8px" onclick="shatoEditProduct(\'' + p.id + '\')">' + (p.titleStore || p.titleAmazon || 'Sin título') + '</div>'
    + '<div class="product-card-prices" style="margin-bottom:8px"><div class="price-amazon">Amazon: <span>$' + (p.priceAmazon||0).toFixed(2) + '</span></div><div class="price-arrow">→</div><div class="price-store" style="font-weight:700;color:#2ade80">$' + (p.priceStore||0).toFixed(2) + '</div><div class="margin-badge" style="background:' + (margin>=20?'rgba(42,222,128,0.15)':'rgba(244,63,94,0.15)') + ';color:' + (margin>=20?'#2ade80':'#f43f5e') + '">' + margin + '%</div></div>'
    + '<div class="product-card-tags" style="margin-bottom:10px">'
    + nichoLabel
    + (isKB && p.koiTier ? '<span class="tag core" style="font-size:10px">' + p.koiTier + '</span>' : '')
    + '</div>'
    + '<div class="product-card-actions">' + actions + '</div>'
    + '</div></div>';
}

function shatoRenderInventario() {
  const tbody = document.getElementById('inventario-body');
  if (SHATO_PRODUCTS.length === 0) {
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:40px;color:#6b6b8a">No hay productos en tu inventario aún</td></tr>';
    return;
  }
  tbody.innerHTML = SHATO_PRODUCTS.map(p => {
    const margin = p.priceAmazon > 0 ? Math.round(((p.priceStore - p.priceAmazon) / p.priceStore) * 100) : 0;
    const stockClass = p.stock === 0 ? 'stock-out' : (p.stock <= p.stockMin ? 'stock-low' : 'stock-ok');
    const afLink = shatoBuildAffiliateLink(p.asin);
    return '<tr><td><strong>' + (p.titleStore||p.titleAmazon||'—').substring(0,40) + '...</strong></td>'
      + '<td><code style="font-size:11px">' + (p.asin||'—') + '</code></td>'
      + '<td>' + (SHATO_NICHO_MAP[p.nicho]?.emoji||'📦') + ' ' + (SHATO_NICHO_MAP[p.nicho]?.label||p.nicho||'—') + '</td>'
      + '<td>$' + (p.priceAmazon||0).toFixed(2) + '</td>'
      + '<td><strong>$' + (p.priceStore||0).toFixed(2) + '</strong></td>'
      + '<td><span style="color:' + (margin>=SHATO_CONFIG.minMargin?'#2ade80':'#f43f5e') + '">' + margin + '%</span></td>'
      + '<td class="' + stockClass + '">' + (p.stock||0) + ' uds</td>'
      + '<td>' + (p.sold||0) + '</td>'
      + '<td><div style="display:flex;gap:4px"><a href="' + afLink + '" target="_blank" class="btn btn-amazon btn-sm" style="text-decoration:none;font-size:10px">🛒</a><button class="btn btn-outline btn-sm" onclick="shatoEditProduct(\'' + p.id + '\')" style="font-size:10px">✏️</button></div></td></tr>';
  }).join('');
}

function shatoRenderDespachos() {
  const list = document.getElementById('despachos-list');
  if (SHATO_DESPACHOS.length === 0) {
    list.innerHTML = '<div class="empty-state" style="padding:60px"><i class="fas fa-box-open"></i><h3>Sin ventas pendientes</h3><p>Las ventas de MeLi y Shopify aparecerán aquí automáticamente</p></div>';
    return;
  }
  list.innerHTML = SHATO_DESPACHOS.map(d => shatoRenderDespachoCard(d)).join('');
}

function shatoRenderDespachoCard(d) {
  const afLink = shatoBuildAffiliateLink(d.asin);
  const isDone = d.status === 'done';
  return '<div class="dispatch-card ' + (isDone ? 'done' : '') + '">'
    + '<div class="dispatch-header"><div><div class="dispatch-product">' + (d.productTitle||'Producto') + '</div><div class="dispatch-order">Orden: ' + (d.orderId||'—') + ' · ' + (d.channel||'MeLi') + '</div></div><div class="dispatch-time">' + (isDone ? '✅ Despachado' : '🔴 Urgente') + '</div></div>'
    + '<div class="dispatch-info"><div class="dispatch-info-item"><div class="label">Vendiste a</div><div class="value">$' + (d.salePrice||0).toFixed(2) + '</div></div><div class="dispatch-info-item"><div class="label">Costo Amazon</div><div class="value">$' + (d.amazonPrice||0).toFixed(2) + '</div></div><div class="dispatch-info-item"><div class="label">Tu ganancia</div><div class="value" style="color:#2ade80">$' + ((d.salePrice||0)-(d.amazonPrice||0)).toFixed(2) + '</div></div></div>'
    + '<div class="dispatch-actions"><a href="' + afLink + '" target="_blank" class="btn btn-amazon" style="text-decoration:none"><i class="fab fa-amazon"></i> Comprar en Amazon</a>'
    + (!isDone ? '<button class="btn btn-success" onclick="shatoMarkDispatched(\'' + d.id + '\')"><i class="fas fa-check"></i> Marcar despachado</button>' : '')
    + '</div></div>';
}

function shatoSearchDispatch(query) {
  if (!query || query.length < 2) { document.getElementById('dispatch-result').classList.remove('show'); return; }
  const q = query.toLowerCase().trim();
  const prod = SHATO_PRODUCTS.find(p => (p.asin && p.asin.toLowerCase() === q) || (p.titleStore && p.titleStore.toLowerCase().includes(q)) || (p.titleAmazon && p.titleAmazon.toLowerCase().includes(q)));
  const resultEl = document.getElementById('dispatch-result');
  if (!prod) { resultEl.classList.remove('show'); return; }
  const margin   = prod.priceAmazon > 0 ? Math.round(((prod.priceStore - prod.priceAmazon) / prod.priceStore) * 100) : 0;
  const afLink   = shatoBuildAffiliateLink(prod.asin);
  const comRate  = prod.nicho === 'kbeauty' ? 0.10 : 0.03;
  const comision = (prod.priceAmazon * comRate).toFixed(2);
  resultEl.innerHTML = '<div class="dispatch-result-header">'
    + (prod.image ? '<img class="dispatch-result-img" src="' + prod.image + '" alt="">' : '')
    + '<div class="dispatch-result-info"><div class="dispatch-result-title">' + (prod.titleStore||prod.titleAmazon) + '</div><div class="dispatch-result-asin">ASIN: ' + prod.asin + '</div></div></div>'
    + '<div class="dispatch-financials"><div class="fin-item"><div class="fin-label">Amazon</div><div class="fin-value">$' + (prod.priceAmazon||0).toFixed(2) + '</div></div><div class="fin-item green"><div class="fin-label">Tu precio</div><div class="fin-value">$' + (prod.priceStore||0).toFixed(2) + '</div></div><div class="fin-item green"><div class="fin-label">Ganancia</div><div class="fin-value">$' + ((prod.priceStore||0)-(prod.priceAmazon||0)).toFixed(2) + '</div></div><div class="fin-item yellow"><div class="fin-label">Comisión</div><div class="fin-value">$' + comision + '</div></div></div>'
    + '<div style="display:flex;gap:10px"><a href="' + afLink + '" target="_blank" class="btn btn-amazon" style="text-decoration:none;flex:1;justify-content:center"><i class="fab fa-amazon"></i> COMPRAR EN AMAZON</a><button class="btn btn-outline" onclick="shatoAddDespachoManual(\'' + prod.id + '\')"><i class="fas fa-plus"></i> Registrar venta</button></div>';
  resultEl.classList.add('show');
}

function shatoAddDespachoManual(productId) {
  const prod = SHATO_PRODUCTS.find(p => p.id === productId);
  if (!prod) return;
  const salePrice = parseFloat(prompt('¿A qué precio vendiste?', prod.priceStore)) || prod.priceStore;
  const orderId   = prompt('Número de orden MeLi (opcional):', '') || 'MANUAL-' + Date.now();
  SHATO_DESPACHOS.unshift({ id:'d-'+Date.now(), productId:prod.id, asin:prod.asin, productTitle:prod.titleStore||prod.titleAmazon, amazonPrice:prod.priceAmazon, salePrice, orderId, channel:'MeLi', status:'pending', createdAt:new Date().toISOString() });
  shatoSaveData();
  shatoRenderDashboard();
  shatoShowNotif('✅ Venta registrada', 'success');
}

function shatoMarkDispatched(id) {
  const d = SHATO_DESPACHOS.find(x => x.id === id);
  if (d) { d.status = 'done'; d.dispatchedAt = new Date().toISOString(); shatoSaveData(); shatoRenderDespachos(); shatoRenderDashboard(); shatoShowNotif('✅ Marcado como despachado', 'success'); }
}

// ── MODAL ──
function shatoMapScraperToPortal(scraped) {
  if (!scraped) return scraped;
  if (scraped.titleAmazon !== undefined) return scraped;
  let desc = '';
  if (scraped.bullets && scraped.bullets.length > 0) desc = scraped.bullets.map(b => '• ' + b).join('\n');
  if (scraped.description && scraped.description.length > 10) desc += (desc ? '\n\n' : '') + scraped.description;
  let nicho = '';
  if (scraped.importMode === 'kbeauty' || scraped.detectedKBeauty) nicho = 'kbeauty';
  return { asin:scraped.asin||'', image:(scraped.images&&scraped.images[0])||'', images:scraped.images||[], titleAmazon:scraped.title||'', titleStore:scraped.title||'', description:desc, categoryAmazon:scraped.category||(scraped.breadcrumbs&&scraped.breadcrumbs.join(' > '))||'', priceAmazon:scraped.price||'', brand:scraped.brand||'', nicho, shipping:'0', stock:'0', stockMin:'2', _scraperData:{ breadcrumbs:scraped.breadcrumbs||[], specifications:scraped.specifications||{}, dimensions:scraped.dimensions||'', weight:scraped.weight||'', ingredients:scraped.ingredients||'', rating:scraped.rating, reviewCount:scraped.reviewCount, currency:scraped.currency||'USD', originalPrice:scraped.originalPrice, kbeautyKeywords:scraped.kbeautyKeywords||[], affiliateUrl:scraped.affiliateUrl||'', amazonTag:scraped.amazonTag||'', pageUrl:scraped.pageUrl||'' } };
}

function shatoOpenCaptureModal(prefill) {
  shatoEditingId = null;
  SHATO_INGREDIENTS = [];
  document.getElementById('modalTitle').textContent = '📦 Nuevo Producto';
  document.getElementById('btn-reject').style.display = 'none';
  shatoClearForm();
  const mapped = prefill ? shatoMapScraperToPortal(prefill) : null;
  if (mapped) {
    shatoFillForm(mapped);
    if (mapped._scraperData && mapped._scraperData.ingredients && mapped._scraperData.ingredients.length > 5) {
      setTimeout(() => shatoShowNotif('🧪 Ingredientes disponibles del scraper', 'info'), 600);
    }
    if (mapped._scraperData && mapped._scraperData.amazonTag && !SHATO_CONFIG.amazonTag) {
      SHATO_CONFIG.amazonTag = mapped._scraperData.amazonTag;
    }
  }
  document.getElementById('captureModal').classList.add('open');
}

function shatoEditProduct(id) {
  const prod = SHATO_PRODUCTS.find(p => p.id === id);
