// ── RECIBIR PRODUCTO DESDE LA EXTENSIÓN CHROME ──
// Método 1: shato_data en la URL (base64 JSON) — funciona siempre
// Método 2: chrome.storage.local — fallback si está disponible
// Método 3: window.postMessage — para pestañas ya abiertas

function shatoCheckChromeStorage() {
  const params = new URLSearchParams(location.search);
  if (!params.has('shato_import')) return;

  // ── Método 1: leer desde parámetro ?shato_data= (base64 JSON) ──
  const shatoData = params.get('shato_data');
  if (shatoData) {
    try {
      const json    = decodeURIComponent(escape(atob(shatoData)));
      const scraped = JSON.parse(json);
      if (scraped && (scraped.title || scraped.asin)) {
        // Limpiar URL sin recargar
        history.replaceState({}, '', location.pathname);
        setTimeout(() => shatoReceiveProduct(scraped), 600);
        return;
      }
    } catch (e) {
      console.warn('[SHATO] Error decodificando shato_data:', e);
    }
  }

  // ── Método 2: chrome.storage.local (fallback) ──
  if (typeof chrome !== 'undefined' && chrome.storage) {
    chrome.storage.local.get(['shato_pending_product'], (result) => {
      if (chrome.runtime.lastError) return;
      const scraped = result.shato_pending_product;
      if (!scraped) return;
      setTimeout(() => {
        shatoReceiveProduct(scraped);
        try { chrome.runtime.sendMessage({ action: 'productConsumed' }); } catch(_) {}
      }, 800);
    });
  }
}

// ── Recibir producto de Amazon: agregar a Pendientes SIN abrir modal ──
function shatoReceiveProduct(scraped) {
  // Convertir formato scraper → formato portal
  const mapped = shatoMapScraperToPortal(scraped);
  if (!mapped) return;

  // Verificar si ya existe por ASIN para no duplicar
  if (mapped.asin && SHATO_PRODUCTS.find(p => p.asin === mapped.asin)) {
    shatoShowNotif('ℹ️ Producto ya existe en tu lista (ASIN: ' + mapped.asin + ')', 'info');
    shatoNavigate('pendientes');
    return;
  }

  // Asegurar nicho kbeauty si vino con importMode kbeauty o detectedKBeauty
  if (!mapped.nicho) {
    if (scraped.importMode === 'kbeauty' || scraped.detectedKBeauty) {
      mapped.nicho = 'kbeauty';
    }
  }

  // Calcular precio de tienda con margen
  const priceAmazon = parseFloat(mapped.priceAmazon) || 0;
  const margin = SHATO_CONFIG.defaultMargin || 35;
  const priceStore = priceAmazon > 0
    ? parseFloat((priceAmazon / (1 - margin / 100)).toFixed(2))
    : 0;

  // Crear producto con estado pendiente
  const prod = Object.assign({}, mapped, {
    id:         'p-' + Date.now(),
    status:     'pending',
    stock:      0,
    stockMin:   2,
    shipping:   0,
    sold:       0,
    createdAt:  new Date().toISOString(),
    priceStore: priceStore
  });

  // Agregar al inicio de la lista
  SHATO_PRODUCTS.unshift(prod);
  shatoSaveData();

  // Nombre del nicho para la notificación
  const nichoInfo = SHATO_NICHO_MAP[prod.nicho] || null;
  const nichoTxt  = nichoInfo ? ' → ' + nichoInfo.emoji + ' ' + nichoInfo.label : '';
  const shortTitle = (prod.titleAmazon || prod.titleStore || 'Producto').substring(0, 45);

  // Mostrar notificación con botón para abrir detalle
  shatoShowNotifWithAction(
    '📦 ' + shortTitle + '...' + nichoTxt,
    'Ver detalle →',
    () => shatoEditProduct(prod.id)
  );

  // Navegar a Pendientes y renderizar
  shatoNavigate('pendientes');
}

// ── Notificación con botón de acción ──
function shatoShowNotifWithAction(msg, actionLabel, actionFn) {
  const container = document.getElementById('notif-container');
  if (!container) { shatoShowNotif(msg, 'success'); return; }
  const el = document.createElement('div');
  el.className = 'notif success';
  el.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:default;';
  el.innerHTML = '<span>' + msg + '</span>';
  const btn = document.createElement('button');
  btn.textContent = actionLabel;
  btn.style.cssText = 'background:#6c63ff;border:none;border-radius:6px;color:#fff;font-size:11px;font-weight:700;padding:4px 10px;cursor:pointer;white-space:nowrap;';
  btn.addEventListener('click', () => { el.remove(); actionFn(); });
  el.appendChild(btn);
  container.appendChild(el);
  setTimeout(() => { if (el.parentNode) el.remove(); }, 8000);
}

// ── Navegación programática ──
function shatoNavigate(section) {
  // Activar item del sidebar
  document.querySelectorAll('#shato-app .sidebar-item').forEach(i => i.classList.remove('active'));
  // Mostrar tab correcto
  document.querySelectorAll('#shato-app .tab-content').forEach(t => t.classList.remove('active'));
  const tab = document.getElementById('tab-' + section);
  if (tab) {
    tab.classList.add('active');
    if (section === 'pendientes') shatoRenderPendientes();
    if (section === 'dashboard') shatoRenderDashboard();
  }
}

// ── INIT ──
document.addEventListener('DOMContentLoaded', () => {
  shatoInit();
  setTimeout(shatoCheckChromeStorage, 500);
});
</script>
