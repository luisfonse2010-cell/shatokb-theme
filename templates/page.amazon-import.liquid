function shatoPublishProduct() {
  const nicho       = document.getElementById('f-nicho').value;
  const titleAmazon = document.getElementById('f-title-amazon').value.trim();
  const titleStore  = document.getElementById('f-title-store').value.trim();
  const asin        = document.getElementById('f-asin').value.trim();
  const priceAmazon = parseFloat(document.getElementById('f-price-amazon').value) || 0;
  const shipping    = parseFloat(document.getElementById('f-shipping').value) || 0;
  const margin      = parseFloat(document.getElementById('f-margin').value) || SHATO_CONFIG.defaultMargin;
  const cost        = priceAmazon + shipping;
  const priceStore  = margin > 0 ? cost / (1 - margin / 100) : cost;
  if (!nicho) { shatoShowNotif('⚠️ Seleccioná un nicho', 'warning'); return; }
  if (!titleAmazon && !titleStore) { shatoShowNotif('⚠️ Completá el título', 'warning'); return; }
  // Preservar status del producto si ya estaba publicado; de lo contrario marcar como published ahora
  const existingProd = shatoEditingId ? SHATO_PRODUCTS.find(p => p.id === shatoEditingId) : null;
  const newStatus = existingProd && existingProd.status === 'published' ? 'published' : 'published'; // Siempre published al guardar desde modal
  const prod = { id: shatoEditingId || 'p-' + Date.now(), status: newStatus, nicho, image:document.getElementById('f-img').value.trim(), asin, titleAmazon, titleStore:titleStore||titleAmazon, description:document.getElementById('f-desc').value.trim(), categoryAmazon:document.getElementById('f-category-amazon').value.trim(), priceAmazon, shipping, priceStore:parseFloat(priceStore.toFixed(2)), stock:parseInt(document.getElementById('f-stock').value)||0, stockMin:parseInt(document.getElementById('f-stock-min').value)||2, sold:existingProd?existingProd.sold||0:0, ingredients:[...SHATO_INGREDIENTS], createdAt:existingProd?existingProd.createdAt:new Date().toISOString(), publishedAt:new Date().toISOString(), affiliateLink:shatoBuildAffiliateLink(asin) };
  if (nicho === 'kbeauty') {
    prod.koiCategoria   = document.getElementById('f-koi-categoria').value;
    prod.koiSubcategoria = document.getElementById('f-koi-subcategoria').value;
    prod.koiTier        = document.getElementById('f-koi-tier').value;
    prod.koiArchetype   = document.getElementById('f-koi-archetype').value;
    prod.koiSafety      = document.getElementById('f-koi-safety').value;
    prod.koiPhase       = document.getElementById('f-koi-phase').value;
    prod.koiNivel       = document.getElementById('f-koi-nivel').value;
    prod.koiPosAM       = parseInt(document.getElementById('f-koi-pos-am').value) || 4;
    prod.koiPosPM       = parseInt(document.getElementById('f-koi-pos-pm').value) || 5;
    const sel = document.querySelector('#f-momento .chip.selected');
    prod.momento = sel ? sel.dataset.val : 'both';
    prod.fit = { dry:parseInt(document.getElementById('fit-dry').value)/100, oily:parseInt(document.getElementById('fit-oily').value)/100, combination:parseInt(document.getElementById('fit-combo').value)/100, sensitive:parseInt(document.getElementById('fit-sens').value)/100, acne:parseInt(document.getElementById('fit-acne').value)/100, pigmentation:parseInt(document.getElementById('fit-pig').value)/100 };
  }
  if (shatoEditingId) { const idx = SHATO_PRODUCTS.findIndex(p => p.id === shatoEditingId); if (idx !== -1) SHATO_PRODUCTS[idx] = prod; }
  else { SHATO_PRODUCTS.unshift(prod); }
  shatoSaveData();
  shatoCloseModal('captureModal');
  shatoRenderDashboard();
  shatoRenderPendientes();
  const nichoInfoP = SHATO_NICHO_MAP[prod.nicho] || null;
  if (SHATO_CONFIG.shopifyToken) {
    shatoPublishToShopify(prod);
  } else {
    const nichoTxtP = nichoInfoP ? ' ' + nichoInfoP.emoji + ' ' + nichoInfoP.label : '';
    shatoShowNotifWithAction(
      '✅ Guardado' + nichoTxtP + ' · Configurá el token Shopify para publicar en la tienda',
      nichoInfoP ? 'Ver en ' + nichoInfoP.label + ' →' : 'Ver Pendientes →',
      () => nichoInfoP ? shatoShowNicho(prod.nicho) : shatoShowTab('pendientes')
    );
  }
}

function shatoQuickPublish(id) {
  const prod = SHATO_PRODUCTS.find(p => p.id === id);
  if (!prod) return;
  // Si no tiene nicho asignado, intentar detectar automáticamente o pedir
  if (!prod.nicho) {
    const nicho = prompt('¿A qué nicho pertenece este producto?\nEjemplos: kbeauty, electronica, hogar, herramientas, deportes, salud, otros', 'kbeauty');
    if (!nicho) return;
    prod.nicho = nicho.trim().toLowerCase();
  }
  // Marcar como publicado localmente siempre
  const idx = SHATO_PRODUCTS.findIndex(p => p.id === id);
  if (idx !== -1) {
    SHATO_PRODUCTS[idx].status = 'published';
    SHATO_PRODUCTS[idx].publishedAt = new Date().toISOString();
  }
  shatoSaveData();
  shatoRenderDashboard();
  shatoRenderPendientes();
  // Mostrar notificación con link al nicho
  const nichoInfo = SHATO_NICHO_MAP[prod.nicho] || { label: prod.nicho, emoji: '📦' };
  shatoShowNotifWithAction(
    '✅ Publicado en ' + nichoInfo.emoji + ' ' + nichoInfo.label,
    'Ver en ' + nichoInfo.label + ' →',
    () => shatoShowNicho(prod.nicho)
  );
  // Si hay token Shopify, publicar en la API también
  if (SHATO_CONFIG.shopifyToken) {
    shatoPublishToShopify(SHATO_PRODUCTS[idx] || prod);
  }
}

