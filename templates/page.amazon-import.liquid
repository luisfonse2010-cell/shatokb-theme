{% comment %}
  SHATO Import Center — Template para Shopify
  ============================================
  Archivo: templates/page.amazon-import.liquid
  
  Instrucciones de instalación:
  1. En el Admin de Shopify → Online Store → Themes → Edit code
  2. En "Templates" → Add a new template → page → nombre: amazon-import
  3. Pegar este contenido completo
  4. Crear una página en Pages → Title: "SHATO Import" → Template: page.amazon-import
  5. La URL será: shatokb.com/pages/amazon-import (o el handle que elijas)
  
  IMPORTANTE: Esta página NO debe aparecer en el menú de navegación.
  Solo vos sabés la URL. Es tu panel privado de operaciones.
{% endcomment %}

{{ 'https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css' | stylesheet_tag }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ── RESET: anular estilos del tema Shopify ── */
.page-width, .page-container, main > .container,
.shopify-section, #MainContent, .main-content,
.template-page .page-width { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }
header, .site-header, nav, .announcement-bar,
footer, .site-footer { display: none !important; }
body { overflow-x: hidden; }

/* ── RESET & BASE ── */
#shato-app * { margin: 0; padding: 0; box-sizing: border-box; }
#shato-app {
  --bg:        #0d0d14;
  --bg2:       #13131f;
  --bg3:       #1a1a2e;
  --border:    #2a2a40;
  --accent:    #6c63ff;
  --accent2:   #ff6584;
  --green:     #2ade80;
  --yellow:    #fbbf24;
  --red:       #f43f5e;
  --blue:      #38bdf8;
  --text:      #eeeef5;
  --muted:     #6b6b8a;
  --sidebar-w: 240px;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  font-size: 14px;
  position: fixed;
  inset: 0;
  z-index: 9999;
  overflow: hidden;
}

/* ── SIDEBAR ── */
#shato-app .sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--bg2);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0; top: 0; bottom: 0;
  z-index: 100;
  overflow-y: auto;
}
#shato-app .sidebar-logo { padding: 20px 16px; border-bottom: 1px solid var(--border); }
#shato-app .sidebar-logo .brand { font-size: 11px; font-weight: 800; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; }
#shato-app .sidebar-logo .title { font-size: 16px; font-weight: 700; color: var(--text); margin-top: 4px; }
#shato-app .sidebar-logo .title span { color: var(--accent); }
#shato-app .sidebar-search { padding: 12px 16px; border-bottom: 1px solid var(--border); }
#shato-app .sidebar-search input { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; color: var(--text); font-size: 12px; outline: none; }
#shato-app .sidebar-search input::placeholder { color: var(--muted); }
#shato-app .sidebar-search input:focus { border-color: var(--accent); }
#shato-app .sidebar-section { padding: 8px 0; border-bottom: 1px solid var(--border); }
#shato-app .sidebar-section-title { font-size: 10px; font-weight: 700; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; padding: 8px 16px 4px; }
#shato-app .sidebar-item { display: flex; align-items: center; gap: 10px; padding: 9px 16px; cursor: pointer; transition: all 0.15s; color: var(--muted); font-size: 13px; font-weight: 500; border-left: 3px solid transparent; }
#shato-app .sidebar-item:hover { background: var(--bg3); color: var(--text); }
#shato-app .sidebar-item.active { background: var(--bg3); color: var(--accent); border-left-color: var(--accent); }
#shato-app .sidebar-item .icon { width: 16px; text-align: center; font-size: 14px; }
#shato-app .sidebar-badge { margin-left: auto; background: var(--accent); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 10px; min-width: 18px; text-align: center; }
#shato-app .sidebar-badge.red { background: var(--red); }
#shato-app .sidebar-badge.green { background: var(--green); color: #000; }
#shato-app .sidebar-badge.yellow { background: var(--yellow); color: #000; }
#shato-app .sidebar-footer { margin-top: auto; padding: 16px; border-top: 1px solid var(--border); }
#shato-app .sidebar-footer .store-info { display: flex; align-items: center; gap: 10px; }
#shato-app .store-avatar { width: 32px; height: 32px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; color: #fff; }
#shato-app .store-name { font-size: 12px; font-weight: 600; }
#shato-app .store-url { font-size: 10px; color: var(--muted); }

/* ── MAIN ── */
#shato-app .main { margin-left: var(--sidebar-w); flex: 1; min-height: 100vh; display: flex; flex-direction: column; overflow-y: auto; }
#shato-app .topbar { background: var(--bg2); border-bottom: 1px solid var(--border); padding: 14px 24px; display: flex; align-items: center; gap: 16px; position: sticky; top: 0; z-index: 50; }
#shato-app .topbar-title { font-size: 16px; font-weight: 700; flex: 1; }
#shato-app .topbar-search { display: flex; align-items: center; gap: 8px; background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 8px 14px; width: 320px; }
#shato-app .topbar-search input { background: none; border: none; outline: none; color: var(--text); font-size: 13px; width: 100%; }
#shato-app .topbar-search input::placeholder { color: var(--muted); }
#shato-app .topbar-search i { color: var(--muted); }

/* ── BUTTONS ── */
#shato-app .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; font-family: 'Inter', sans-serif; }
#shato-app .btn-primary { background: var(--accent); color: #fff; }
#shato-app .btn-primary:hover { background: #5a52e0; }
#shato-app .btn-success { background: var(--green); color: #000; }
#shato-app .btn-success:hover { background: #22c96d; }
#shato-app .btn-danger { background: var(--red); color: #fff; }
#shato-app .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
#shato-app .btn-outline:hover { border-color: var(--accent); color: var(--accent); }
#shato-app .btn-sm { padding: 5px 10px; font-size: 12px; }
#shato-app .btn-amazon { background: #ff9900; color: #000; }
#shato-app .btn-amazon:hover { background: #e68a00; }

#shato-app .content { padding: 24px; flex: 1; }
#shato-app .tab-content { display: none; }
#shato-app .tab-content.active { display: block; }

/* ── STATS ── */
#shato-app .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
#shato-app .stat-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
#shato-app .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
#shato-app .stat-value { font-size: 28px; font-weight: 800; line-height: 1; }
#shato-app .stat-sub { font-size: 11px; color: var(--muted); margin-top: 6px; }
#shato-app .stat-card.green .stat-value { color: var(--green); }
#shato-app .stat-card.yellow .stat-value { color: var(--yellow); }
#shato-app .stat-card.red .stat-value { color: var(--red); }
#shato-app .stat-card.blue .stat-value { color: var(--blue); }

/* ── SECTIONS ── */
#shato-app .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
#shato-app .section-title { font-size: 15px; font-weight: 700; }
#shato-app .section-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ── PRODUCT CARDS ── */
#shato-app .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
#shato-app .product-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: border-color 0.15s; }
#shato-app .product-card:hover { border-color: var(--accent); }
#shato-app .product-card-img { width: 100%; height: 160px; object-fit: contain; background: #fff; padding: 12px; }
#shato-app .product-card-body { padding: 14px; }
#shato-app .product-card-asin { font-size: 10px; color: var(--muted); font-family: monospace; margin-bottom: 4px; }
#shato-app .product-card-title { font-size: 13px; font-weight: 600; line-height: 1.4; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
#shato-app .product-card-prices { display: flex; gap: 12px; margin-bottom: 10px; align-items: center; }
#shato-app .price-amazon { font-size: 12px; color: var(--muted); }
#shato-app .price-amazon span { color: var(--text); font-weight: 600; }
#shato-app .price-arrow { color: var(--muted); font-size: 11px; }
#shato-app .price-store { font-size: 13px; font-weight: 700; color: var(--green); }
#shato-app .margin-badge { margin-left: auto; background: var(--bg3); border: 1px solid var(--border); border-radius: 6px; padding: 3px 8px; font-size: 11px; font-weight: 700; color: var(--yellow); }
#shato-app .product-card-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 10px; }
#shato-app .tag { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: var(--bg3); color: var(--muted); border: 1px solid var(--border); }
#shato-app .tag.kbeauty { background: #1a0a1e; color: #e879f9; border-color: #6b21a8; }
#shato-app .tag.nicho { background: #0a1628; color: var(--blue); border-color: #1e3a5f; }
#shato-app .tag.core { background: #0a1f14; color: var(--green); border-color: #14532d; }
#shato-app .product-card-actions { display: flex; gap: 8px; flex-wrap: wrap; }

/* ── DISPATCH CARDS ── */
#shato-app .dispatch-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 12px; border-left: 4px solid var(--red); }
#shato-app .dispatch-card.done { border-left-color: var(--green); opacity: 0.6; }
#shato-app .dispatch-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
#shato-app .dispatch-product { font-size: 14px; font-weight: 700; }
#shato-app .dispatch-order { font-size: 11px; color: var(--muted); margin-top: 2px; }
#shato-app .dispatch-time { font-size: 11px; color: var(--red); font-weight: 600; white-space: nowrap; }
#shato-app .dispatch-info { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; background: var(--bg3); border-radius: 8px; padding: 10px 14px; margin-bottom: 10px; }
#shato-app .dispatch-info-item .label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
#shato-app .dispatch-info-item .value { font-size: 14px; font-weight: 700; margin-top: 2px; }
#shato-app .dispatch-actions { display: flex; gap: 8px; }

/* ── MODAL ── */
#shato-app .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 200; display: none; align-items: center; justify-content: center; padding: 24px; }
#shato-app .modal-overlay.open { display: flex; }
#shato-app .modal { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 760px; max-height: 90vh; overflow-y: auto; }
#shato-app .modal-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: var(--bg2); z-index: 10; }
#shato-app .modal-title { font-size: 16px; font-weight: 700; }
#shato-app .modal-close { width: 32px; height: 32px; background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 16px; }
#shato-app .modal-close:hover { color: var(--text); border-color: var(--accent); }
#shato-app .modal-body { padding: 24px; }
#shato-app .modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; position: sticky; bottom: 0; background: var(--bg2); }

/* ── FORMS ── */
#shato-app .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
#shato-app .form-group { margin-bottom: 16px; }
#shato-app .form-group.full { grid-column: 1 / -1; }
#shato-app .form-label { font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; display: block; }
#shato-app .form-input, #shato-app .form-select, #shato-app .form-textarea { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; color: var(--text); font-size: 13px; outline: none; font-family: 'Inter', sans-serif; transition: border-color 0.15s; }
#shato-app .form-input:focus, #shato-app .form-select:focus, #shato-app .form-textarea:focus { border-color: var(--accent); }
#shato-app .form-textarea { resize: vertical; min-height: 80px; }
#shato-app .form-select option { background: var(--bg2); }

/* ── PRICE CALC ── */
#shato-app .price-calc { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
#shato-app .price-calc-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 12px; }
#shato-app .price-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 13px; }
#shato-app .price-row .label { color: var(--muted); }
#shato-app .price-row .value { font-weight: 600; }
#shato-app .price-row.total { border-top: 1px solid var(--border); padding-top: 8px; margin-top: 4px; font-size: 15px; }
#shato-app .price-row.total .value { color: var(--green); font-size: 18px; }
#shato-app .margin-slider { width: 100%; accent-color: var(--accent); }

/* ── KOI INTEL ── */
#shato-app .koi-intel-section { background: #0d0a1f; border: 1px solid #3b0764; border-radius: 10px; padding: 16px; margin-top: 16px; }
#shato-app .koi-intel-title { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: #e879f9; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
#shato-app .fit-sliders { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
#shato-app .fit-item .fit-label { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
#shato-app .fit-item .fit-label span:first-child { color: var(--muted); }
#shato-app .fit-item .fit-label span:last-child { color: var(--text); font-weight: 700; }
#shato-app .fit-slider { width: 100%; accent-color: #e879f9; }
#shato-app .ingredients-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
#shato-app .ingredient-tag { display: flex; align-items: center; gap: 4px; background: #1a0a2e; border: 1px solid #6b21a8; border-radius: 6px; padding: 3px 8px; font-size: 11px; color: #e879f9; }
#shato-app .ingredient-tag .remove { cursor: pointer; color: var(--muted); font-size: 10px; }
#shato-app .ingredient-tag .remove:hover { color: var(--red); }
#shato-app .koi-score-bar { background: var(--bg); border-radius: 8px; height: 8px; overflow: hidden; margin-top: 6px; }
#shato-app .koi-score-fill { height: 100%; background: linear-gradient(90deg, #6c63ff, #e879f9); border-radius: 8px; transition: width 0.3s; }

/* ── TOGGLES ── */
#shato-app .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); }
#shato-app .toggle-row:last-child { border-bottom: none; }
#shato-app .toggle-label { font-size: 13px; font-weight: 500; }
#shato-app .toggle-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
#shato-app .toggle { position: relative; width: 40px; height: 22px; flex-shrink: 0; }
#shato-app .toggle input { opacity: 0; width: 0; height: 0; }
#shato-app .toggle-slider { position: absolute; inset: 0; background: var(--border); border-radius: 22px; cursor: pointer; transition: 0.2s; }
#shato-app .toggle-slider:before { content: ''; position: absolute; width: 16px; height: 16px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: 0.2s; }
#shato-app .toggle input:checked + .toggle-slider { background: var(--accent); }
#shato-app .toggle input:checked + .toggle-slider:before { transform: translateX(18px); }

/* ── NICHOS ── */
#shato-app .nicho-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
#shato-app .nicho-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 16px; cursor: pointer; transition: all 0.15s; text-align: center; }
#shato-app .nicho-card:hover, #shato-app .nicho-card.active { border-color: var(--accent); background: var(--bg3); }
#shato-app .nicho-emoji { font-size: 28px; margin-bottom: 8px; }
#shato-app .nicho-name { font-size: 13px; font-weight: 600; }
#shato-app .nicho-count { font-size: 11px; color: var(--muted); margin-top: 4px; }

/* ── DISPATCH SEARCH ── */
#shato-app .dispatch-search-box { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
#shato-app .dispatch-search-input { display: flex; gap: 12px; }
#shato-app .dispatch-search-input input { flex: 1; background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; color: var(--text); font-size: 15px; outline: none; font-family: 'Inter', sans-serif; }
#shato-app .dispatch-search-input input:focus { border-color: var(--accent); }
#shato-app .dispatch-result { background: var(--bg2); border: 1px solid var(--green); border-radius: 12px; padding: 20px; display: none; }
#shato-app .dispatch-result.show { display: block; }
#shato-app .dispatch-result-header { display: flex; gap: 16px; margin-bottom: 16px; }
#shato-app .dispatch-result-img { width: 80px; height: 80px; object-fit: contain; background: #fff; border-radius: 8px; padding: 6px; flex-shrink: 0; }
#shato-app .dispatch-result-info { flex: 1; }
#shato-app .dispatch-result-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
#shato-app .dispatch-result-asin { font-size: 11px; color: var(--muted); font-family: monospace; }
#shato-app .dispatch-financials { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; background: var(--bg3); border-radius: 10px; padding: 14px; margin-bottom: 16px; }
#shato-app .fin-item .fin-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
#shato-app .fin-item .fin-value { font-size: 18px; font-weight: 800; margin-top: 4px; }
#shato-app .fin-item.green .fin-value { color: var(--green); }
#shato-app .fin-item.yellow .fin-value { color: var(--yellow); }

/* ── ALERTS ── */
#shato-app .alert { border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; display: flex; align-items: flex-start; gap: 10px; font-size: 13px; }
#shato-app .alert-warning { background: #1a1200; border: 1px solid #854d0e; color: var(--yellow); }
#shato-app .alert-success { background: #0a1f14; border: 1px solid #14532d; color: var(--green); }
#shato-app .alert-danger { background: #1a0a0a; border: 1px solid #7f1d1d; color: var(--red); }
#shato-app .alert-info { background: #0a1628; border: 1px solid #1e3a5f; color: var(--blue); }

/* ── TABLE ── */
#shato-app .table-wrap { overflow-x: auto; }
#shato-app table { width: 100%; border-collapse: collapse; }
#shato-app th { background: var(--bg3); padding: 10px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); text-align: left; border-bottom: 1px solid var(--border); }
#shato-app td { padding: 12px 14px; border-bottom: 1px solid var(--border); font-size: 13px; }
#shato-app tr:hover td { background: var(--bg3); }
#shato-app .stock-ok { color: var(--green); font-weight: 700; }
#shato-app .stock-low { color: var(--yellow); font-weight: 700; }
#shato-app .stock-out { color: var(--red); font-weight: 700; }

/* ── CONFIG ── */
#shato-app .config-section { background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 16px; }
#shato-app .config-section-title { font-size: 14px; font-weight: 700; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }

/* ── EMPTY STATE ── */
#shato-app .empty-state { text-align: center; padding: 60px 24px; color: var(--muted); }
#shato-app .empty-state i { font-size: 48px; margin-bottom: 16px; opacity: 0.3; display: block; }
#shato-app .empty-state h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; color: var(--text); }
#shato-app .empty-state p { font-size: 13px; line-height: 1.6; }

/* ── SCROLLBAR ── */
#shato-app ::-webkit-scrollbar { width: 6px; height: 6px; }
#shato-app ::-webkit-scrollbar-track { background: var(--bg); }
#shato-app ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
#shato-app ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

/* ── NOTIFICATIONS ── */
#shato-app .notif-container { position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
#shato-app .notif { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; font-size: 13px; display: flex; align-items: center; gap: 10px; min-width: 280px; pointer-events: all; animation: shatoSlideIn 0.3s ease; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
#shato-app .notif.success { border-color: var(--green); }
#shato-app .notif.error { border-color: var(--red); }
#shato-app .notif.warning { border-color: var(--yellow); }
@keyframes shatoSlideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* ── CHIP SELECTOR ── */
#shato-app .chip-selector { display: flex; flex-wrap: wrap; gap: 6px; }
#shato-app .chip { padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border); font-size: 12px; font-weight: 500; cursor: pointer; background: var(--bg3); color: var(--muted); transition: all 0.15s; }
#shato-app .chip:hover { border-color: var(--accent); color: var(--text); }
#shato-app .chip.selected { background: var(--accent); border-color: var(--accent); color: #fff; }
#shato-app .chip.selected.kbeauty { background: #7e22ce; border-color: #7e22ce; }
</style>

