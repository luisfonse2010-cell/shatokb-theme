<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }} · {{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    #shopify-section-header,
    #shopify-section-footer,
    #shopify-section-announcement-bar,
