{% comment %}
  ============================================================
  SHATOKB · Hero + Benefits + Quiz — All-in-one
  File: sections/shatokb-hero.liquid

  Structure:
  1. <section> Hero — Charcoal + Rose (C3)
  2. <div>     Benefits — B4c Tinted Fade
  3. <div>     Quiz — skin diagnosis engine
  4. <div>     Email gate modal
  5. <div>     Result container

  Merged into one section to avoid the 25-section Shopify limit.
  All CSS lives in assets/shatokb-quiz.css (loaded below).
  All JS logic lives in assets/shatokb-quiz.js (loaded at bottom).
  ============================================================
{% endcomment %}

{{ 'shatokb-quiz.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-chat.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-vision.css' | asset_url | stylesheet_tag }}

<style>
  /* ── HERO — C3 Charcoal + Rose ───────────────────────────── */
  #shatokb-hero {
    background: linear-gradient(135deg, #1c1c1e 0%, #2a1f24 100%) !important;
    min-height: 600px !important;
    padding: 100px 24px 96px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    position: relative !important;
  }
  #shatokb-hero .shatokb-hero__inner {
    width: 100% !important;
    max-width: 820px !important;
    margin: 0 auto !important;
  }
  #shatokb-hero .shatokb-hero__badge {
    display: inline-block !important;
    background: rgba(245,160,187,0.12) !important;
    color: #f5a0bb !important;
    border: 1px solid rgba(245,160,187,0.30) !important;
    border-radius: 50px !important;
    padding: 9px 24px !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    margin-bottom: 32px !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    font-family: 'Arimo', Arial, sans-serif !important;
  }
  #shatokb-hero .shatokb-hero__title {
    font-family: 'Prompt', 'Arial Black', sans-serif !important;
    font-size: 48px !important;
    font-weight: 800 !important;
    line-height: 1.05 !important;
    margin: 0 0 28px !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    letter-spacing: -0.5px !important;
  }
  #shatokb-hero .shatokb-hero__title em {
    font-style: italic !important;
    color: #f5a0bb !important;
  }
  #shatokb-hero .shatokb-hero__subtitle {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 16px !important;
    line-height: 1.70 !important;
    margin: 0 auto 44px !important;
    max-width: 560px !important;
    color: rgba(255,255,255,0.65) !important;
  }
  #shatokb-hero .shatokb-hero__ctas {
    display: flex !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    margin-bottom: 44px !important;
  }
  #shatokb-hero .shatokb-btn--primary {
    background: #f5a0bb !important;
    color: #1c1c1e !important;
    border: 2px solid #f5a0bb !important;
    padding: 18px 44px !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    border-radius: 6px !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    letter-spacing: 0.01em !important;
    transition: background 0.2s ease, transform 0.2s ease !important;
  }
  #shatokb-hero .shatokb-btn--primary:hover {
    background: #e0607e !important;
    border-color: #e0607e !important;
    transform: translateY(-2px) !important;
  }
  #shatokb-hero .shatokb-hero__trust {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 12px !important;
    font-size: 13px !important;
    color: rgba(255,255,255,0.40) !important;
    font-family: 'Arimo', Arial, sans-serif !important;
  }
  /* ── Quiz section title/subtitle — override Halo base 10px ── */
  .shatokb-quiz-section__titulo {
    font-family: 'Prompt', 'Arial Black', sans-serif !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #0b0335 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.02em !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .shatokb-quiz-section__subtitulo {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 15px !important;
    color: #6b7280 !important;
    margin: 0 !important;
    line-height: 1.55 !important;
  }
  .shatokb-progreso__meta {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 14px !important;
    color: #6b7280 !important;
  }
  @media (max-width: 768px) {
    #shatokb-hero { padding: 72px 24px 64px !important; min-height: auto !important; }
    #shatokb-hero .shatokb-hero__title { font-size: 38px !important; }
    #shatokb-hero .shatokb-hero__subtitle { font-size: 16px !important; }
    #shatokb-hero .shatokb-btn--primary { width: 100% !important; justify-content: center !important; }
    .shatokb-quiz-section__titulo { font-size: 22px !important; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════════
     1. HERO
═══════════════════════════════════════════════════════════ -->
<section id="shatokb-hero" class="shatokb-hero">
  <div class="shatokb-hero__inner">

    <span class="shatokb-hero__badge">
      🎫 {{ section.settings.badge_text }}
    </span>

    <h1 class="shatokb-hero__title">
      Your skin has been waiting for <em>this</em> routine.
    </h1>

    <p class="shatokb-hero__subtitle">
      {{ section.settings.subtitle }}
    </p>

    <div class="shatokb-hero__ctas">
      <a href="/pages/skin-quiz" class="shatokb-btn shatokb-btn--primary">
        {{ section.settings.cta_primary }} →
      </a>
    </div>

    <div class="shatokb-hero__trust">
      <span>⭐⭐⭐⭐⭐ +2,000 routines already revealed</span>
      <span>·</span>
      <span>🌿 100% authentic K-Beauty</span>
      <span>·</span>
      <span>⚡ Results in weeks, not months</span>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     2. BENEFITS — B4c Tinted Fade
═══════════════════════════════════════════════════════════ -->
<div id="shatokb-beneficios" class="shatokb-beneficios">
  <div class="shatokb-beneficios__inner">

    {%- if section.settings.benefits_title != blank -%}
      <h2 class="shatokb-section-title">{{ section.settings.benefits_title }}</h2>
    {%- endif -%}

    <div class="shatokb-beneficios__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <article class="shatokb-beneficio-card" {{ block.shopify_attributes }}>
            <div class="shatokb-beneficio-card__icon" aria-hidden="true">{{ block.settings.icon_emoji }}</div>
            <h3 class="shatokb-beneficio-card__title">{{ block.settings.title }}</h3>
            <p class="shatokb-beneficio-card__desc">{{ block.settings.description }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     2b. SECOND CTA — Debajo de benefit cards
═══════════════════════════════════════════════════════════ -->
<div id="stk-benefit-cta" style="text-align:center; padding:8px 24px 56px;">

  <style>
    /* ── Second CTA Button ───────────────────────────────────── */
    #stk-benefit-cta-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: 10px !important;
      padding: 16px 40px !important;
      background: transparent !important;
      border: 2px solid #f5a0bb !important;
      border-radius: 6px !important;
      color: #0b0335 !important;
      font-family: 'Arimo', Arial, sans-serif !important;
      font-size: 15px !important;
      font-weight: 700 !important;
      letter-spacing: 0.02em !important;
      cursor: pointer !important;
      text-decoration: none !important;
      transition: background 0.22s ease, color 0.22s ease, transform 0.15s ease, box-shadow 0.22s ease !important;
      box-shadow: 0 0 0 0 rgba(245,160,187,0) !important;
      position: relative !important;
    }
    #stk-benefit-cta-btn:hover {
      background: rgba(245,160,187,0.12) !important;
      color: #0b0335 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 28px rgba(245,160,187,0.30) !important;
      border-color: #f5a0bb !important;
    }
    #stk-benefit-cta-btn .stk-cta-arrow {
      display: inline-block;
      transition: transform 0.22s ease;
      font-style: normal;
    }
    #stk-benefit-cta-btn:hover .stk-cta-arrow {
      transform: translateX(5px);
    }
    #stk-benefit-microcopy {
      font-family: 'Arimo', Arial, sans-serif;
      font-size: 12px;
      color: #9ca3af;
      margin: 10px 0 0;
      letter-spacing: 0.01em;
    }
  </style>

  <a id="stk-benefit-cta-btn"
     href="/pages/skin-quiz">
    Build My Skin Routine — It's Free <span class="stk-cta-arrow">→</span>
  </a>

  <p id="stk-benefit-microcopy">Takes 3 minutes · No account needed · +50,000 routines created</p>

</div>

<!-- ═══════════════════════════════════════════════════════════
     3. QUIZ — Skin Diagnosis (only shown when show_quiz = true)
═══════════════════════════════════════════════════════════ -->
{%- if section.settings.show_quiz -%}
<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.quiz_titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.quiz_subtitulo }}</p>
    </header>

    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:15px; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 28px;">
        Most people spend years — and hundreds of dollars — trying random products that don't work for their skin.<br><br>
        <strong>This quiz ends that.</strong> In 2 minutes you'll know your exact skin profile and the Korean products proven to work for it.
      </p>
      <button style="display:inline-flex;align-items:center;justify-content:center;padding:15px 36px;background:#3a7af5;color:#fff;font-family:'Arimo',Arial,sans-serif;font-size:16px;font-weight:700;border:none;border-radius:6px;cursor:pointer;text-decoration:none;transition:background 0.2s;" type="button" onclick="event.stopPropagation();event.preventDefault();shatokbIniciarQuiz();return false;">
        Yes — show me my routine →
      </button>
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:13px; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    <div id="shatokb-progreso" class="shatokb-progreso" style="display:none;"
      role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 6</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    <div id="shatokb-quiz-form" class="shatokb-quiz-form" style="display:none;"
      aria-live="polite" aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     4. EMAIL GATE MODAL
═══════════════════════════════════════════════════════════ -->
<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop" onclick="shatokbSaltarEmail()"></div>
  <div class="stk-gate__card">
    <span class="stk-gate__emoji">🎁</span>
    <h2 class="stk-gate__title" id="stk-gate-title">Your routine is ready!</h2>
    <p class="stk-gate__sub">Where should we send it so you can come back to it anytime?</p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input type="email" id="stk-email-input" class="stk-gate__input"
        placeholder="your@email.com" required autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Show me my routine ✨
      </button>
    </form>
    <button class="stk-gate__skip" type="button" onclick="shatokbSaltarEmail()">
      No thanks, just show me the routine
    </button>
    <p class="stk-gate__privacy">🔒 No spam. No subscriptions. Just your routine.</p>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     5. RESULT CONTAINER
═══════════════════════════════════════════════════════════ -->
<div id="shatokb-resultado" class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite" aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

{%- endif -%}

{%- if section.settings.show_quiz -%}
<script src="{{ 'shatokb-quiz.js' | asset_url }}" defer></script>
<script src="{{ 'shatokb-koi-vision.js' | asset_url }}?v=20260619A" defer></script>
<script src="{{ 'shatokb-koi-chat.js' | asset_url }}?v=20260619A" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero + Benefits + Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_quiz",
      "label": "Show quiz on this page",
      "info": "Disable on the home page — quiz lives at /pages/skin-quiz",
      "default": false
    },

    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "The skin secret Korean women have had for years - now yours"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "6 questions. 2 minutes. A complete routine built exclusively for your skin - with the exact Korean products that will actually change it."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "CTA button text",
      "default": "Reveal My Skin Routine"
    },

    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefits_title",
      "label": "Benefits section title",
      "default": "Why choose your routine with us?"
    },

    {
      "type": "header",
      "content": "Quiz"
    },
    {
      "type": "text",
      "id": "quiz_titulo",
      "label": "Quiz section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "quiz_subtitulo",
      "label": "Quiz section subtitle",
      "default": "2 minutes. 6 questions. A complete routine with real Korean products - chosen for your skin, your concerns and your budget. Free."
    },

    {
      "type": "header",
      "content": "Button - Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Button - WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_whatsapp_text",
      "label": "Button text",
      "default": "Talk to a skin expert"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_number",
      "label": "WhatsApp number (with country code, no +)",
      "default": "12345678900",
      "info": "Example: 17865551234 (US) - 34612345678 (Spain)"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_message",
      "label": "Pre-written message",
      "default": "Hi! I just took the skin quiz and need help with my routine."
    },

    {
      "type": "header",
      "content": "Button - Retake Quiz"
    },
    {
      "type": "checkbox",
      "id": "btn_retake_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_retake_text",
      "label": "Button text",
      "default": "My skin feels different - redo"
    },

    {
      "type": "header",
      "content": "Sticky Total Bar"
    },
    {
      "type": "text",
      "id": "total_bar_label",
      "label": "Bar label",
      "default": "Estimated total for your routine"
    },
    {
      "type": "text",
      "id": "total_bar_cta",
      "label": "Add to cart button text",
      "default": "Add my full routine to cart"
    }

  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji / Icon",
          "default": "target"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personalised recommendation"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Not every product works the same for every skin. We help you find exactly yours."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero + Benefits + Quiz",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_emoji": "target",
            "title": "Personalised recommendation",
            "description": "We match products to your exact skin needs - no one-size-fits-all approach."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_emoji": "leaf",
            "title": "Routines for your skin type",
            "description": "Morning and night. Step by step. Tailored to oily, dry, sensitive or combination skin."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_emoji": "KR",
            "title": "Authentic K-Beauty products",
            "description": "Genuine Korean brands with science-backed ingredients trusted by millions worldwide."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_emoji": "chat",
            "title": "Guided shopping via WhatsApp",
            "description": "Have questions? Our team helps you choose and build your ideal routine before you buy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
