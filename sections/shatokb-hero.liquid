{% comment %}
  ============================================================
  SHATOKB · Hero Principal — Diagnóstico de Piel
  Archivo: sections/shatokb-hero.liquid
  
  Cómo usar:
  - Añadir en templates/index.json dentro del array "order"
  - Personalizable desde el editor visual de Shopify
  ============================================================
{% endcomment %}

<section
  id="shatokb-hero"
  class="shatokb-hero"
  style="
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1800 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="shatokb-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="shatokb-hero__inner">

    {%- if section.settings.badge_text != blank -%}
      <span class="shatokb-hero__badge">{{ section.settings.badge_text }}</span>
    {%- endif -%}

    <h1 class="shatokb-hero__title" style="color: {{ section.settings.title_color }};">
      {{ section.settings.title }}
    </h1>

    <p class="shatokb-hero__subtitle" style="color: {{ section.settings.subtitle_color }};">
      {{ section.settings.subtitle }}
    </p>

    <div class="shatokb-hero__ctas">
      <a
        href="#shatokb-quiz"
        class="shatokb-btn shatokb-btn--primary"
        onclick="shatokbScrollToQuiz(event)"
        aria-label="{{ section.settings.cta_primary }}"
      >
        {{ section.settings.cta_primary }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      {%- if section.settings.cta_secondary != blank -%}
        <a
          href="{{ section.settings.cta_secondary_url }}"
          class="shatokb-btn shatokb-btn--secondary"
          aria-label="{{ section.settings.cta_secondary }}"
        >
          {{ section.settings.cta_secondary }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_trust_bar -%}
      <div class="shatokb-hero__trust">
        <span>⭐⭐⭐⭐⭐ +2.000 rutinas recomendadas</span>
        <span>·</span>
        <span>🌿 100% productos originales</span>
        <span>·</span>
        <span>🔄 Satisfacción garantizada</span>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  function shatokbScrollToQuiz(e) {
    e.preventDefault();
    const quiz = document.getElementById('shatokb-quiz');
    if (quiz) {
      quiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

{% schema %}
{
  "name": "🌸 Hero — Diagnóstico",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto badge (opcional)",
      "default": "✨ K-Beauty · Diagnóstico personalizado"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Descubre la rutina coreana hecha para tu piel"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Responde 6 preguntas y te recomendamos los productos exactos que necesita tu piel. Sin adivinar. Sin perderte."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "Botón principal",
      "default": "Empezar diagnóstico"
    },
    {
      "type": "text",
      "id": "cta_secondary",
      "label": "Botón secundario (opcional)",
      "default": "Ver best sellers"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Enlace botón secundario"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Mostrar barra de confianza",
      "default": true
    },
    {
      "type": "header",
      "content": "Imagen de fondo"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Oscuridad del overlay",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#232323"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#c8d9ff"
    }
  ],
  "presets": [
    {
      "name": "🌸 Hero — Diagnóstico"
    }
  ]
}
{% endschema %}
