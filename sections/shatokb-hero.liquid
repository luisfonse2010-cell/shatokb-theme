    font-family: 'Arimo', Arial, sans-serif !important;
  }
  /* SOCIAL PROOF BAR */
  #shatokb-hero .stk-social-proof {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    margin-bottom: 20px !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #f5c842 !important;
  }
  #shatokb-hero .stk-social-proof span.stk-sp-count {
    color: rgba(255,255,255,0.85) !important;
    font-weight: 700 !important;
  }
  /* URGENCY LINE */
  #shatokb-hero .stk-urgency {
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px !important;
    background: rgba(245,160,187,0.10) !important;
    border: 1px solid rgba(245,160,187,0.25) !important;
    border-radius: 50px !important;
    padding: 7px 18px !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #f5a0bb !important;
    margin-bottom: 20px !important;
    letter-spacing: 0.02em !important;
  }
  /* GUARANTEE */
  #shatokb-hero .stk-guarantee {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    margin-top: 16px !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 12px !important;
    color: rgba(255,255,255,0.45) !important;
  }
  /* SECONDARY BTN */
  #shatokb-hero .shatokb-btn--secondary {
    background: transparent !important;
    color: rgba(255,255,255,0.65) !important;
    border: 1px solid rgba(255,255,255,0.20) !important;
    padding: 16px 32px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    border-radius: 6px !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    cursor: pointer !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    transition: all 0.2s ease !important;
    margin-top: 12px !important;
  }
  #shatokb-hero .shatokb-btn--secondary:hover {
    border-color: rgba(255,255,255,0.45) !important;
    color: #fff !important;
