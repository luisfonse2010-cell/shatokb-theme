{% comment %}
  ============================================================
  SHATOKB · Main Hero — Skin Diagnosis
  File: sections/shatokb-hero.liquid

  How to use:
  - Add in templates/index.json inside the "order" array
  - Fully customisable from the Shopify Theme Editor
  ============================================================
{% endcomment %}

<section
  id="shatokb-hero"
  class="shatokb-hero"
  style="
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1800 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="shatokb-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="shatokb-hero__inner">

    {%- if section.settings.badge_text != blank -%}
      <span class="shatokb-hero__badge">{{ section.settings.badge_text }}</span>
    {%- endif -%}

    <h1 class="shatokb-hero__title" style="color: {{ section.settings.title_color }};">
      {{ section.settings.title }}
    </h1>

    <p class="shatokb-hero__subtitle" style="color: {{ section.settings.subtitle_color }};">
      {{ section.settings.subtitle }}
    </p>

    <div class="shatokb-hero__ctas">
      <a
        href="#shatokb-quiz"
        class="shatokb-btn shatokb-btn--primary"
        onclick="shatokbScrollToQuiz(event)"
        aria-label="{{ section.settings.cta_primary }}"
      >
        {{ section.settings.cta_primary }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      {%- if section.settings.cta_secondary != blank -%}
        <a
          href="{{ section.settings.cta_secondary_url }}"
          class="shatokb-btn shatokb-btn--secondary"
          aria-label="{{ section.settings.cta_secondary }}"
        >
          {{ section.settings.cta_secondary }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_trust_bar -%}
      <div class="shatokb-hero__trust">
        <span>⭐⭐⭐⭐⭐ 2,000+ routines recommended</span>
        <span>·</span>
        <span>🌿 100% authentic products</span>
        <span>·</span>
        <span>🔄 Satisfaction guaranteed</span>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  function shatokbScrollToQuiz(e) {
    e.preventDefault();
    const quiz = document.getElementById('shatokb-quiz');
    if (quiz) {
      quiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

{% schema %}
{
  "name": "🌸 Hero — Diagnosis",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text (optional)",
      "default": "✨ K-Beauty · Personalised skin diagnosis"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main title",
      "default": "Discover the Korean routine made for your skin"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Answer 6 questions and we'll recommend the exact products your skin needs. No guessing. No getting lost."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "Primary button",
      "default": "Start diagnosis"
    },
    {
      "type": "text",
      "id": "cta_secondary",
      "label": "Secondary button (optional)",
      "default": "View best sellers"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#0b0335"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle colour",
      "default": "#c8d9ff"
    }
  ],
  "presets": [
    {
      "name": "🌸 Hero — Diagnosis"
    }
  ]
}
{% endschema %}
