    <div style="display:inline-flex;align-items:center;gap:8px;margin-top:18px;padding:10px 20px;background:#fff;border:1px solid #f0e0e8;border-radius:50px;font-family:'Arimo',Arial,sans-serif;font-size:12px;font-weight:600;color:#6b7280;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
