<!-- ═══════════════════════════════════════════════════════════
     3. QUIZ — Skin Diagnosis (only shown when show_quiz = true)
═══════════════════════════════════════════════════════════ -->
{%- if section.settings.show_quiz -%}
<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.quiz_titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.quiz_subtitulo }}</p>
    </header>

    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:15px; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 28px;">
        Most people waste hundreds of dollars on products that don't work for their skin.<br><br>
        <strong>This ends now.</strong> 8 questions. Your exact skin profile. The K-Beauty products proven to work for it.
      </p>
      <button style="display:inline-flex;align-items:center;justify-content:center;padding:15px 36px;background:#3a7af5;color:#fff;font-family:'Arimo',Arial,sans-serif;font-size:16px;font-weight:700;border:none;border-radius:6px;cursor:pointer;text-decoration:none;transition:background 0.2s;" type="button" onclick="event.stopPropagation();event.preventDefault();shatokbIniciarQuiz();return false;">
        Find my perfect products →
      </button>
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:13px; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    <div id="shatokb-progreso" class="shatokb-progreso" style="display:none;"
      role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 8</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    <div id="shatokb-quiz-form" class="shatokb-quiz-form" style="display:none;"
      aria-live="polite" aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     4. EMAIL GATE MODAL
═══════════════════════════════════════════════════════════ -->
<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop"></div>
  <div class="stk-gate__card">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
      <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#ec95b8,#d4688a);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🌸</div>
      <span style="font-size:14px;font-weight:700;color:#fff;">KOI</span>
    </div>
    <h2 class="stk-gate__title" id="stk-gate-title">🔬 Your skin analysis is ready</h2>
    <p class="stk-gate__sub">KOI built a custom routine for your exact profile. Send it to your email — <strong style="color:#ec95b8;">it expires in 24 hours.</strong></p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input type="email" id="stk-email-input" class="stk-gate__input"
        placeholder="your@email.com" required autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Send my routine →
      </button>
    </form>
    <p class="stk-gate__privacy">🔒 No spam. Unsubscribe anytime. Just your personalized routine.</p>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     5. RESULT CONTAINER
═══════════════════════════════════════════════════════════ -->
<div id="shatokb-resultado" class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite" aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

{%- endif -%}

{%- if section.settings.show_quiz -%}
<script src="{{ 'shatokb-quiz.js' | asset_url }}&v=95" defer></script>
<script src="{{ 'shatokb-koi-vision.js' | asset_url }}&v=95" defer></script>
<script src="{{ 'shatokb-koi-chat.js' | asset_url }}&v=95" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero + Benefits + Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_quiz",
      "label": "Show quiz on this page",
      "info": "Disable on the home page — quiz lives at /pages/skin-quiz",
      "default": false
    },

    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "The K-Beauty secret that actually works — now for you"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "8 questions. Real diagnosis. K-Beauty products that work for your specific skin type."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "CTA button text",
      "default": "Find my perfect products"
    },

    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefits_title",
      "label": "Benefits section title",
      "default": "Your skin. Your products. Zero guessing."
    },

    {
      "type": "header",
      "content": "Quiz"
    },
    {
      "type": "text",
      "id": "quiz_titulo",
      "label": "Quiz section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "quiz_subtitulo",
      "label": "Quiz section subtitle",
      "default": "8 questions. Real diagnosis. K-Beauty products chosen for your skin, your concerns and your budget. Free."
    },

    {
      "type": "header",
      "content": "Button - Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Button - WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
