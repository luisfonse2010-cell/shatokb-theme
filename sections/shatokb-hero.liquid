    <!-- SOCIAL PROOF -->
    <div class="stk-social-proof">
      ⭐⭐⭐⭐⭐&nbsp;<span class="stk-sp-count">2,400+ women</span>&nbsp;already know their exact routine
    </div>

    <!-- URGENCY -->
    <div class="stk-urgency">
      🔥 <span>847 skin analyses this week &mdash; Free today only</span>
    </div>

    <!-- CTAs -->
    <div class="shatokb-hero__ctas" style="flex-direction:column;align-items:center;gap:0;margin-bottom:12px;">
      <a href="/pages/skin-quiz" class="shatokb-btn shatokb-btn--primary">
        {{ section.settings.cta_primary }} →
