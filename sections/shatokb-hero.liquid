    <!-- GUARANTEE -->
    <div class="stk-guarantee">
      🛡️ <span>30-Day Money Back Guarantee &mdash; No results? Full refund. No questions asked.</span>
    </div>

    <div class="shatokb-hero__trust" style="margin-top:20px;">
      <span>🌿 Hand-picked K-Beauty</span>
      <span>·</span>
      <span>⚡ Results in weeks</span>
      <span>·</span>
