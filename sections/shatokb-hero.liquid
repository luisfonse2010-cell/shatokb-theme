</section>

<!-- ═══════════════════════════════════════════════════════════
     2. BENEFITS + CTA — Bloque unificado WOW
═══════════════════════════════════════════════════════════ -->
<style>
  #shatokb-beneficios {
    background: #f9f6f7 !important;
    padding: 72px 24px !important;
    text-align: center !important;
  }
  .stk-benefits-inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .stk-benefits-title {
    font-family: 'Prompt', 'Arial Black', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #0b0335;
    margin: 0 0 40px;
    line-height: 1.15;
    letter-spacing: -0.3px;
  }
  .stk-benefits-title span {
    color: #e0607e;
  }
  .stk-benefits-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 44px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .stk-benefits-list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(0,0,0,0.07);
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #0b0335;
    text-align: left;
  }
  .stk-benefits-list li:last-child {
    border-bottom: none;
  }
  .stk-check {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, #f5a0bb, #e0607e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(245,160,187,0.35);
  }
  #stk-benefit-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 18px 44px !important;
    background: #f5a0bb !important;
    border: none !important;
    border-radius: 6px !important;
    color: #1c1c1e !important;
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    letter-spacing: 0.01em !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: background 0.22s ease, transform 0.15s ease, box-shadow 0.22s ease !important;
    box-shadow: 0 8px 32px rgba(245,160,187,0.30) !important;
  }
  #stk-benefit-cta-btn:hover {
    background: #f5a0bb !important;
    border: 2px solid #e0607e !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 32px rgba(245,160,187,0.30) !important;
  }
  #stk-benefit-cta-btn .stk-cta-arrow {
    display: inline-block;
    transition: transform 0.22s ease;
    font-style: normal;
  }
  #stk-benefit-cta-btn:hover .stk-cta-arrow {
    transform: translateX(5px);
  }
  #stk-benefit-microcopy {
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 12px;
    color: #9ca3af;
    margin: 14px 0 0;
    letter-spacing: 0.02em;
  }
  @media (max-width: 768px) {
    #shatokb-beneficios { padding: 56px 20px !important; }
    .stk-benefits-title { font-size: 26px; }
    .stk-benefits-list li { font-size: 15px; }
    #stk-benefit-cta-btn { width: 100% !important; justify-content: center !important; }
  }
</style>

<div id="shatokb-beneficios">
  <div class="stk-benefits-inner">

    <h2 class="stk-benefits-title">
