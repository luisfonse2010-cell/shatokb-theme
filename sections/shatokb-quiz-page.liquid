    display: none !important;
  }
  .sqp-quiz-wrap .shatokb-quiz-section__header {
    display: none !important; /* el header SEO está en .sqp-hero */
  }

  /* ── Sección de beneficios debajo del hero ── */
  .sqp-benefits {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 20px 24px;
    background: #f8f9fc;
    border-bottom: 1px solid #e5e7eb;
    flex-wrap: wrap;
  }
  .sqp-benefit {
