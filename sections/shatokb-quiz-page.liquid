{%- comment -%} ── SEO HEAD TAGS ─────────────────────────────────── {%- endcomment -%}
{%- capture seo_title -%}{{ section.settings.seo_title | default: 'Free K-Beauty Skin Quiz — Find Your Korean Skincare Routine | SHATOKB' }}{%- endcapture -%}
{%- capture seo_description -%}{{ section.settings.seo_description | default: 'Answer 8 questions and get your personalized Korean skincare routine — chosen by AI for your exact skin type, concerns and budget. Free. No account needed.' }}{%- endcapture -%}
{%- assign seo_image = section.settings.seo_image | default: '' -%}
{%- assign page_url = shop.url | append: '/pages/skin-quiz' -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ page_url }}",
      "url": "{{ page_url }}",
      "name": "{{ seo_title }}",
      "description": "{{ seo_description }}",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "{{ shop.url }}",
        "name": "{{ shop.name }}",
        "url": "{{ shop.url }}"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop.url }}"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Skin Quiz",
            "item": "{{ page_url }}"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does the skin quiz take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The quiz takes about 2-3 minutes. You answer 8 questions about your skin type, concerns, lifestyle and budget."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Korean skincare quiz free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, completely free. No account needed, no credit card, no email required to see your results."
          }
        },
        {
          "@type": "Question",
          "name": "How does the AI choose products for my skin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "KOI, our AI skin expert, analyzes your skin profile, concerns and budget to select the best Korean skincare products specifically for you from our curated catalogue of 200+ products."
          }
        },
        {
          "@type": "Question",
          "name": "What skin types does the quiz cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The quiz covers all skin types: dry, oily, combination, sensitive, normal and mature skin. It also addresses specific concerns like acne, dark spots, anti-aging, hydration and brightening."
          }
        }
      ]
    }
  ]
}
</script>

