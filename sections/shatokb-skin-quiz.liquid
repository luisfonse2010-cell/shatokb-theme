{% comment %}
  ============================================================
  SHATOKB · Skin Diagnosis Quiz  v3.0
  File: sections/shatokb-skin-quiz.liquid

  Includes:
  - Section header (badge, title, subtitle) — editable from Theme Editor
  - Quiz start screen
  - Progress bar
  - Quiz form container (questions injected by JS)
  - Email gate modal
  - Result container (injected by JS after quiz completes)
  - All CTA buttons editable from Theme Editor via schema settings
  - All settings passed to JS via data-* attributes on <section>

  Assets:
  - assets/shatokb-quiz.css
  - assets/shatokb-quiz.js
  ============================================================
{% endcomment %}

{{ 'shatokb-quiz.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-chat.css' | asset_url | stylesheet_tag }}

<style>

  /* ══════════════════════════════════════════════
     BLOQUE COPY D v3 — horizontal, sin caja,
     efectos WOW integrados con el theme
     ══════════════════════════════════════════════ */

  @keyframes stk-fade-up   { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-2 { 0%,28%{opacity:0;transform:translateY(16px)} 100%{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-3 { 0%,52%{opacity:0;transform:translateY(12px)} 100%{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-4 { 0%,70%{opacity:0;transform:translateY(10px)} 100%{opacity:1;transform:translateY(0)} }

  @keyframes stk-shimmer {
    0%   { background-position: -600px 0; }
    100% { background-position: 600px 0; }
  }
  @keyframes stk-underline {
    from { transform: scaleX(0); opacity:0; }
    to   { transform: scaleX(1); opacity:1; }
  }
  @keyframes stk-dot-beat {
    0%,100% { transform: scale(1);   opacity:1; }
    50%     { transform: scale(0.55); opacity:0.35; }
  }
  @keyframes stk-float-slow {
    0%,100% { transform: translateY(0); }
    50%     { transform: translateY(-6px); }
  }

  /* Wrapper — sin fondo, sin borde */
  .stk-hook-wrap {
    max-width: 680px;
    margin: 0 auto 56px;
    padding: 0 20px;
    text-align: center;
  }

  /* Eyebrow pill — idéntico al badge del Hero */
  .stk-hook-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(245,160,187,0.10);
    border: 1px solid rgba(245,160,187,0.35);
    border-radius: 50px;
    padding: 7px 20px;
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c26b8e;
    margin-bottom: 32px;
    animation: stk-fade-up 0.7s cubic-bezier(0.22,1,0.36,1) 0.1s both,
               stk-float-slow 4s ease-in-out 1s infinite;
  }
  .stk-hook-eyebrow-dot {
    width: 5px; height: 5px;
    background: #f5a0bb;
    border-radius: 50%;
    flex-shrink: 0;
    animation: stk-dot-beat 1.6s ease-in-out infinite;
  }

  /* Headline principal — una sola línea horizontal grande */
  .stk-hook-headline {
    font-family: 'Prompt', 'Arial Black', sans-serif;
    font-size: 38px;
    font-weight: 800;
    color: #0b0335;
    line-height: 1.15;
    margin: 0 0 6px;
    letter-spacing: -0.025em;
    animation: stk-fade-up 0.85s cubic-bezier(0.22,1,0.36,1) 0.2s both;
  }

  /* "al azar" — shimmer animado */
  .stk-hook-azar {
    position: relative;
    display: inline-block;
  }
  .stk-hook-azar-text {
    background: linear-gradient(90deg,
      #0b0335 0%,
      #f5a0bb 30%,
      #ec95b8 50%,
      #f5a0bb 70%,
      #0b0335 100%);
    background-size: 600px 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: stk-shimmer 3s linear 1s infinite;
  }
  /* Subrayado ondulado bajo "al azar" */
  .stk-hook-azar::after {
    content: '';
    position: absolute;
    left: 0; bottom: -5px;
    width: 100%; height: 3px;
    background: linear-gradient(90deg, #f5a0bb, #ec95b8, #f5a0bb);
    background-size: 200% 100%;
    border-radius: 2px;
    transform-origin: left;
    animation: stk-underline 0.7s cubic-bezier(0.22,1,0.36,1) 1.1s both,
               stk-shimmer 2.5s linear 2s infinite;
  }

  /* Segunda línea del headline */
  .stk-hook-headline-b {
    font-family: 'Prompt', 'Arial Black', sans-serif;
    font-size: 38px;
    font-weight: 800;
    color: #0b0335;
    line-height: 1.15;
    margin: 0 0 36px;
    letter-spacing: -0.025em;
    animation: stk-fade-up-2 1.1s cubic-bezier(0.22,1,0.36,1) both;
  }

  /* Remate — texto más suave, Arimo */
  .stk-hook-remate {
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #6b7280;
    line-height: 1.65;
    margin: 0 0 10px;
    animation: stk-fade-up-3 1.3s cubic-bezier(0.22,1,0.36,1) both;
  }

  /* "Ese momento puede ser hoy." — highlight rosa */
  .stk-hook-hoy {
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #0b0335;
    margin: 0 0 32px;
    animation: stk-fade-up-3 1.3s cubic-bezier(0.22,1,0.36,1) 0.05s both;
  }
  .stk-hook-hoy em {
    font-style: normal;
    color: #f5a0bb;
  }

  /* Social proof pill */
  .stk-hook-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(245,160,187,0.4);
    border-radius: 50px;
    padding: 9px 22px;
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #6b7280;
    animation: stk-fade-up-4 1.5s cubic-bezier(0.22,1,0.36,1) both;
  }
  .stk-hook-social strong { color: #f5a0bb; }
  .stk-hook-social-dot {
    width: 6px; height: 6px;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
    animation: stk-dot-beat 1.8s ease-in-out infinite;
  }

  @media (max-width: 640px) {
    .stk-hook-headline,
    .stk-hook-headline-b { font-size: 28px; }
    .stk-hook-remate      { font-size: 16px; }
    .stk-hook-hoy         { font-size: 17px; }
  }

  /* ── Quiz section — override Halo html{font-size:62.5%} base 10px ── */
  .shatokb-quiz-section__titulo {
    font-family: 'Prompt', 'Arial Black', sans-serif !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #0b0335 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.02em !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .shatokb-quiz-section__subtitulo {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 15px !important;
    color: #6b7280 !important;
    margin: 0 !important;
    line-height: 1.55 !important;
  }
  .shatokb-progreso__meta {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 14px !important;
    color: #6b7280 !important;
  }
  @media (max-width: 768px) {
    .shatokb-quiz-section__titulo { font-size: 22px !important; }
  }
</style>

{%- comment -%}
  All Theme Editor settings are passed to JS via data-* attributes.
  The JS reads them with shatokbGetConfig() → no hardcoded values in JS.
{%- endcomment -%}

<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-bestsellers-show="{{ section.settings.btn_bestsellers_show }}"
  data-btn-bestsellers-text="{{ section.settings.btn_bestsellers_text | escape }}"
  data-btn-bestsellers-url="{{ section.settings.btn_bestsellers_url }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    {%- comment -%} ── Hook copy D v3 — horizontal, sin caja ── {%- endcomment -%}
    <div class="stk-hook-wrap" id="stk-hook-block">

      <!-- Pill eyebrow flotante -->
      <p class="stk-hook-eyebrow">
        <span class="stk-hook-eyebrow-dot" aria-hidden="true"></span>
        Tu piel lo está esperando
        <span class="stk-hook-eyebrow-dot" aria-hidden="true"></span>
      </p>

      <!-- Headline línea 1 -->
      <h3 class="stk-hook-headline">
        En algún momento dejarás de probar productos&nbsp;<span class="stk-hook-azar"><span class="stk-hook-azar-text">al azar</span></span>
      </h3>

      <!-- Headline línea 2 -->
      <p class="stk-hook-headline-b">
        y empezarás con tu rutina exacta.
      </p>

      <!-- Remate emocional -->
      <p class="stk-hook-remate">
        Ese momento puede ser hoy.
      </p>
      <p class="stk-hook-hoy">
        <em>Hoy.</em> Descúbrelo en 3 minutos.
      </p>

      <!-- Social proof pill -->
      <div class="stk-hook-social" aria-label="Más de 50.000 rutinas personalizadas creadas">
        <span class="stk-hook-social-dot" aria-hidden="true"></span>
        <span><strong>+50.000</strong> rutinas personalizadas creadas</span>
      </div>

    </div>

    {%- comment -%} ── Section header ──────────────────────────── {%- endcomment -%}
    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      {%- comment -%} badge ocultado — emoji 🇰🇷 eliminado {%- endcomment -%}
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.subtitulo }}</p>
    </header>

    {%- comment -%} ── Quiz start screen ──────────────────────── {%- endcomment -%}
    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:15px; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 28px;">
        Most people spend years — and hundreds of dollars — trying random products that don't work for their skin.<br><br>
        <strong>This quiz ends that.</strong> In 2 minutes you'll know your exact skin profile and the Korean products proven to work for it.
      </p>
      <button
        id="shatokb-btn-inicio"
        style="display:inline-flex;align-items:center;justify-content:center;padding:15px 36px;background:#3a7af5;color:#fff;font-family:'Arimo',Arial,sans-serif;font-size:16px;font-weight:700;border:none;border-radius:6px;cursor:pointer;transition:background 0.2s;"
        type="button"
        onclick="event.stopPropagation();event.preventDefault();shatokbIniciarQuiz();return false;">
        Yes — show me my routine →
      </button>
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:13px; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    {%- comment -%} ── Progress bar ────────────────────────────── {%- endcomment -%}
    <div
      id="shatokb-progreso"
      class="shatokb-progreso"
      style="display:none;"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 6</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    {%- comment -%} ── Quiz questions (injected by JS) ──────────── {%- endcomment -%}
    <div
      id="shatokb-quiz-form"
      class="shatokb-quiz-form"
      style="display:none;"
      aria-live="polite"
      aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

{%- comment -%} ── Email gate modal (outside section for z-index) ─ {%- endcomment -%}
<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop" onclick="shatokbSaltarEmail()"></div>
  <div class="stk-gate__card">
    <span class="stk-gate__emoji">🎁</span>
    <h2 class="stk-gate__title" id="stk-gate-title">Your routine is ready!</h2>
    <p class="stk-gate__sub">Where should we send it so you can come back to it anytime?</p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input
        type="email"
        id="stk-email-input"
        class="stk-gate__input"
        placeholder="your@email.com"
        required
        autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Show me my routine ✨
      </button>
    </form>
    <button class="stk-gate__skip" type="button" onclick="shatokbSaltarEmail()">
      No thanks, just show me the routine
    </button>
    <p class="stk-gate__privacy">🔒 No spam. No subscriptions. Just your routine.</p>
  </div>
</div>

{%- comment -%} ── Result container (injected by JS) ──────────────── {%- endcomment -%}
<div
  id="shatokb-resultado"
  class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite"
  aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

<script src="{{ 'shatokb-quiz.js' | asset_url }}" defer></script>
<script src="{{ 'shatokb-koi-chat.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "🔬 Skin Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [

    {
      "type": "header",
      "content": "📋 Section Header"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text (optional)",
      "default": "🇰🇷 Free · 2 minutes · Real K-Beauty products"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Section subtitle",
      "default": "2 minutes. 6 questions. A complete routine with real Korean products — chosen for your skin, your concerns and your budget. Free."
    },

    {
      "type": "header",
      "content": "🛍️ Button — Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "🛍️ Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link",
      "info": "e.g. /collections/all"
    },

    {
      "type": "header",
      "content": "💬 Button — WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_whatsapp_text",
      "label": "Button text",
      "default": "💬 Talk to a skin expert"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_number",
      "label": "WhatsApp number (with country code, no +)",
      "default": "12345678900",
      "info": "Example: 17865551234 (US) · 34612345678 (Spain)"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_message",
      "label": "Pre-written message",
      "default": "Hi! I just took the skin quiz and need help with my routine."
    },

    {
      "type": "header",
      "content": "⭐ Button — Best Sellers (Hero)"
    },
    {
      "type": "checkbox",
      "id": "btn_bestsellers_show",
      "label": "Show button in hero",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_bestsellers_text",
      "label": "Button text",
      "default": "⭐ View Best Sellers"
    },
    {
      "type": "url",
      "id": "btn_bestsellers_url",
      "label": "Button link",
      "info": "e.g. /collections/best-sellers"
    },

    {
      "type": "header",
      "content": "↺ Button — Retake Quiz"
    },
    {
      "type": "checkbox",
      "id": "btn_retake_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_retake_text",
      "label": "Button text",
      "default": "↺ My skin feels different — redo"
    },

    {
      "type": "header",
      "content": "🛒 Sticky Total Bar"
    },
    {
      "type": "text",
      "id": "total_bar_label",
      "label": "Bar label",
      "default": "Estimated total for your routine"
    },
    {
      "type": "text",
      "id": "total_bar_cta",
      "label": "Add to cart button text",
      "default": "🛒 Add my full routine to cart"
    }

  ],
  "presets": [
    {
      "name": "🔬 Skin Quiz"
    }
  ]
}
{% endschema %}
