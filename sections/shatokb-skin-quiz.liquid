{% comment %}
  ============================================================
  SHATOKB · Skin Diagnosis Quiz  v3.0
  File: sections/shatokb-skin-quiz.liquid

  Includes:
  - Section header (badge, title, subtitle) — editable from Theme Editor
  - Quiz start screen
  - Progress bar
  - Quiz form container (questions injected by JS)
  - Email gate modal
  - Result container (injected by JS after quiz completes)
  - All CTA buttons editable from Theme Editor via schema settings
  - All settings passed to JS via data-* attributes on <section>

  Assets:
  - assets/shatokb-quiz.css
  - assets/shatokb-quiz.js
  - assets/shatokb-koi-vision.css
  - assets/shatokb-koi-vision.js
  - assets/shatokb-koi-chat.css
  - assets/shatokb-koi-chat.js
  ============================================================
{% endcomment %}

{{ 'shatokb-quiz.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-chat.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-vision.css' | asset_url | stylesheet_tag }}
<script>
  // Cache-bust guard: si KOI no carga en 3s, reintentamos dinámicamente
  window.__koiLoadCheck = setTimeout(function() {
    if (typeof window.shatokbIniciarKOI === 'undefined') {
      console.warn('[KOI] shatokb-koi-chat.js no cargó — cargando dinámicamente');
      var s = document.createElement('script');
      s.src = '{{ "shatokb-koi-chat.js" | asset_url }}?fallback=' + Date.now();
      document.head.appendChild(s);
    }
  }, 3000);
</script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

<style>

  /* ══════════════════════════════════════════════
     BLOQUE COPY D v4 — fondo vivo + tipografía
     elegante. Sin caja, sin borde.
     ══════════════════════════════════════════════ */

  @keyframes stk-fade-up   { from{opacity:0;transform:translateY(26px)} to{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-2 { 0%,25%{opacity:0;transform:translateY(20px)} 100%{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-3 { 0%,50%{opacity:0;transform:translateY(14px)} 100%{opacity:1;transform:translateY(0)} }
  @keyframes stk-fade-up-4 { 0%,68%{opacity:0;transform:translateY(10px)} 100%{opacity:1;transform:translateY(0)} }

  @keyframes stk-glow-pulse {
    0%,100% { opacity: 0.55; transform: scale(1);   }
    50%     { opacity: 0.85; transform: scale(1.08); }
  }
  @keyframes stk-glow-pulse-2 {
    0%,100% { opacity: 0.4; transform: scale(1);   }
    50%     { opacity: 0.7; transform: scale(1.12); }
  }
  @keyframes stk-shimmer {
    0%   { background-position: -700px 0; }
    100% { background-position: 700px 0;  }
  }
  @keyframes stk-underline-in {
    from { transform: scaleX(0); opacity: 0; }
    to   { transform: scaleX(1); opacity: 1; }
  }
  @keyframes stk-dot-beat {
    0%,100% { transform: scale(1);    opacity: 1;    }
    50%     { transform: scale(0.5);  opacity: 0.35; }
  }
  @keyframes stk-float-pill {
    0%,100% { transform: translateY(0px); }
    50%     { transform: translateY(-5px); }
  }
  @keyframes stk-particles {
    0%   { transform: translateY(0) scale(1);    opacity: 0.8; }
    100% { transform: translateY(-100px) scale(1.3); opacity: 0; }
  }

  /* ── Wrapper con fondo orgánico ─────────────────── */
  .stk-hook-wrap {
    position: relative;
    max-width: 100vw;
    width: 100vw;
    margin: 0 calc(-50vw + 50%) 48px;
    padding: 56px 80px 48px;
    text-align: center;
    overflow: hidden;
    background:
      linear-gradient(to right,
        transparent 0%,
        rgba(245,160,187,0.08) 8%,
        rgba(245,160,187,0.15) 30%,
        rgba(245,160,187,0.17) 50%,
        rgba(245,160,187,0.15) 70%,
        rgba(245,160,187,0.08) 92%,
        transparent 100%);
    border-radius: 0;
  }

  .stk-hook-orb-1 {
    position: absolute;
    top: 50%; left: -120px;
    transform: translateY(-50%);
    width: 460px; height: 160px;
    background: radial-gradient(ellipse, rgba(245,160,187,0.22) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: stk-glow-pulse 4s ease-in-out infinite;
  }
  .stk-hook-orb-2 {
    position: absolute;
    top: 50%; right: -120px;
    transform: translateY(-50%);
    width: 460px; height: 160px;
    background: radial-gradient(ellipse, rgba(245,160,187,0.18) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    animation: stk-glow-pulse-2 5s ease-in-out 1s infinite;
  }

  .stk-hook-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .stk-hook-particles span {
    position: absolute;
    font-size: 13px;
    opacity: 0;
    animation: stk-particles linear infinite;
  }
  .stk-hook-particles span:nth-child(1){ left:7%;  bottom:5%;  animation-duration:3.4s; animation-delay:0s;   }
  .stk-hook-particles span:nth-child(2){ left:22%; bottom:8%;  animation-duration:4.1s; animation-delay:0.8s; }
  .stk-hook-particles span:nth-child(3){ left:50%; bottom:3%;  animation-duration:3.8s; animation-delay:0.3s; }
  .stk-hook-particles span:nth-child(4){ left:75%; bottom:6%;  animation-duration:4.4s; animation-delay:1.5s; }
  .stk-hook-particles span:nth-child(5){ left:88%; bottom:10%; animation-duration:3.2s; animation-delay:2.1s; }

  .stk-hook-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: rgba(245,160,187,0.12);
    border: 1px solid rgba(245,160,187,0.38);
    border-radius: 50px;
    padding: 7px 22px;
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c0607f;
    margin-bottom: 30px;
    position: relative; z-index: 1;
    animation: stk-fade-up 0.7s cubic-bezier(0.22,1,0.36,1) 0.1s both,
               stk-float-pill 4s ease-in-out 1s infinite;
  }
  .stk-hook-eyebrow-dot {
    width: 5px; height: 5px;
    background: #f5a0bb;
    border-radius: 50%;
    flex-shrink: 0;
    animation: stk-dot-beat 1.7s ease-in-out infinite;
  }

  .stk-hook-headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    font-size: 46px;
    color: #0b0335;
    line-height: 1.15;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
    position: relative; z-index: 1;
    animation: stk-fade-up 0.9s cubic-bezier(0.22,1,0.36,1) 0.22s both;
  }

  .stk-hook-azar {
    position: relative;
    display: inline-block;
  }
  .stk-hook-azar-text {
    font-style: italic;
    background: linear-gradient(90deg,
      #c0607f 0%, #f5a0bb 25%, #ec95b8 50%, #f5a0bb 75%, #c0607f 100%);
    background-size: 700px 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: stk-shimmer 3.5s linear 1s infinite;
  }
  .stk-hook-azar::after {
    content: '';
    position: absolute;
    left: 0; bottom: -4px;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, #f5a0bb, #ec95b8, #f5a0bb);
    border-radius: 2px;
    transform-origin: left;
    animation: stk-underline-in 0.7s cubic-bezier(0.22,1,0.36,1) 1.2s both;
  }

  .stk-hook-headline-b {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    font-size: 46px;
    color: #0b0335;
    line-height: 1.15;
    margin: 0 0 36px;
    letter-spacing: -0.02em;
    position: relative; z-index: 1;
    animation: stk-fade-up-2 1.1s cubic-bezier(0.22,1,0.36,1) both;
  }

  .stk-hook-remate {
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #6b7280;
    line-height: 1.7;
    margin: 0 0 6px;
    position: relative; z-index: 1;
    animation: stk-fade-up-3 1.3s cubic-bezier(0.22,1,0.36,1) both;
  }

  .stk-hook-hoy {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 26px;
    color: #c0607f;
    margin: 0 0 34px;
    position: relative; z-index: 1;
    animation: stk-fade-up-3 1.3s cubic-bezier(0.22,1,0.36,1) 0.08s both;
    letter-spacing: 0.01em;
  }

  .stk-hook-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(245,160,187,0.38);
    border-radius: 50px;
    padding: 9px 22px;
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6b7280;
    position: relative; z-index: 1;
    animation: stk-fade-up-4 1.5s cubic-bezier(0.22,1,0.36,1) both;
  }
  .stk-hook-social strong { color: #c0607f; }
  .stk-hook-social-dot {
    width: 6px; height: 6px;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
    animation: stk-dot-beat 1.8s ease-in-out infinite;
  }

  @media (max-width: 640px) {
    .stk-hook-wrap        { padding: 48px 20px 40px; }
    .stk-hook-headline,
    .stk-hook-headline-b  { font-size: 34px; }
    .stk-hook-hoy         { font-size: 22px; }
    .stk-hook-remate      { font-size: 15px; }
  }

  #shatokb-quiz-cabecera {
    margin-top: 20px !important;
  }

  .shatokb-quiz-section__titulo {
    font-family: 'Prompt', 'Arial Black', sans-serif !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #0b0335 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.02em !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .shatokb-quiz-section__subtitulo {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 15px !important;
    color: #6b7280 !important;
    margin: 0 !important;
    line-height: 1.55 !important;
  }
  .shatokb-progreso__meta {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 14px !important;
    color: #6b7280 !important;
  }
  @media (max-width: 768px) {
    .shatokb-quiz-section__titulo { font-size: 22px !important; }
  }
</style>

{%- comment -%}
  All Theme Editor settings are passed to JS via data-* attributes.
  The JS reads them with shatokbGetConfig() → no hardcoded values in JS.
{%- endcomment -%}

<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-bestsellers-show="{{ section.settings.btn_bestsellers_show }}"
  data-btn-bestsellers-text="{{ section.settings.btn_bestsellers_text | escape }}"
  data-btn-bestsellers-url="{{ section.settings.btn_bestsellers_url }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    {%- comment -%} ── Hook copy D v4 — fondo vivo + Cormorant ── {%- endcomment -%}
    <div class="stk-hook-wrap" id="stk-hook-block">

      <div class="stk-hook-orb-1" aria-hidden="true"></div>
      <div class="stk-hook-orb-2" aria-hidden="true"></div>

      <div class="stk-hook-particles" aria-hidden="true">
        <span>✨</span>
        <span>🌸</span>
        <span>✦</span>
        <span>✨</span>
        <span>🌸</span>
      </div>

      <p class="stk-hook-eyebrow">
        <span class="stk-hook-eyebrow-dot" aria-hidden="true"></span>
        Your skin has been waiting
        <span class="stk-hook-eyebrow-dot" aria-hidden="true"></span>
      </p>

      <h3 class="stk-hook-headline">
        At some point you'll stop trying products&nbsp;<span class="stk-hook-azar"><span class="stk-hook-azar-text">at random</span></span>
      </h3>

      <p class="stk-hook-headline-b">
        and start with your exact routine.
      </p>

      <p class="stk-hook-remate">That moment can be today.</p>
      <p class="stk-hook-hoy">Discover it in 3 minutes.</p>

      <div class="stk-hook-social" aria-label="Over 50,000 personalized routines created">
        <span class="stk-hook-social-dot" aria-hidden="true"></span>
        <span><strong>+50,000</strong> personalized routines created</span>
      </div>

    </div>

    {%- comment -%} ── Section header ──────────────────────────── {%- endcomment -%}
    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.subtitulo }}</p>
    </header>

    {%- comment -%} ── Quiz start screen ──────────────────────── {%- endcomment -%}
    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:15px; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 28px;">
        Most people spend years — and hundreds of dollars — trying random products that don't work for their skin.<br><br>
        <strong>This quiz ends that.</strong> In 2 minutes you'll know your exact skin profile and the Korean products proven to work for it.
      </p>
      <button
        id="shatokb-btn-inicio"
        style="display:inline-flex;align-items:center;justify-content:center;padding:15px 36px;background:#3a7af5;color:#fff;font-family:'Arimo',Arial,sans-serif;font-size:16px;font-weight:700;border:none;border-radius:6px;cursor:pointer;transition:background 0.2s;"
        type="button"
        onclick="event.stopPropagation();event.preventDefault();shatokbIniciarQuiz();return false;">
        Yes — show me my routine →
      </button>
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:13px; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    {%- comment -%} ── Progress bar ────────────────────────────── {%- endcomment -%}
    <div
      id="shatokb-progreso"
      class="shatokb-progreso"
      style="display:none;"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 6</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    {%- comment -%} ── Quiz questions (injected by JS) ──────────── {%- endcomment -%}
    <div
      id="shatokb-quiz-form"
      class="shatokb-quiz-form"
      style="display:none;"
      aria-live="polite"
      aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

{%- comment -%} ── Email gate modal (outside section for z-index) ─ {%- endcomment -%}
<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop"></div>
  <div class="stk-gate__card">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
      <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#ec95b8,#d4688a);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🌸</div>
      <span style="font-size:14px;font-weight:700;color:#fff;">KOI</span>
    </div>
    <h2 class="stk-gate__title" id="stk-gate-title">🔬 Your skin analysis is ready</h2>
    <p class="stk-gate__sub">KOI built a custom routine for your exact profile. Send it to your email — <strong style="color:#ec95b8;">it expires in 24 hours.</strong></p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input
        type="email"
        id="stk-email-input"
        class="stk-gate__input"
        placeholder="your@email.com"
        required
        autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Send my routine →
      </button>
    </form>
    <p class="stk-gate__privacy">🔒 No spam. Unsubscribe anytime. Just your personalized routine.</p>
  </div>
</div>

{%- comment -%} ── Result container (injected by JS) ──────────────── {%- endcomment -%}
<div
  id="shatokb-resultado"
  class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite"
  aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

<script src="{{ 'shatokb-quiz.js' | asset_url }}&v=93" defer></script>
<script src="{{ 'shatokb-koi-vision.js' | asset_url }}&v=92" defer></script>
<script src="{{ 'shatokb-koi-chat.js' | asset_url }}&v=92" defer></script>

{% schema %}
{
  "name": "🔬 Skin Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [

    {
      "type": "header",
      "content": "📋 Section Header"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text (optional)",
      "default": "🇰🇷 Free · 2 minutes · Real K-Beauty products"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Section subtitle",
      "default": "2 minutes. 6 questions. A complete routine with real Korean products — chosen for your skin, your concerns and your budget. Free."
    },

    {
      "type": "header",
      "content": "🛍️ Button — Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "🛍️ Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link",
      "info": "e.g. /collections/all"
    },

    {
      "type": "header",
      "content": "💬 Button — WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_whatsapp_text",
      "label": "Button text",
      "default": "💬 Talk to a skin expert"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_number",
      "label": "WhatsApp number (with country code, no +)",
      "default": "12345678900",
