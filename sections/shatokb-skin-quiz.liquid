{% comment %}
  ============================================================
  SHATOKB · Skin Diagnosis Quiz  v3.0
  File: sections/shatokb-skin-quiz.liquid

  Includes:
  - Section header (badge, title, subtitle) — editable from Theme Editor
  - Quiz start screen
  - Progress bar
  - Quiz form container (questions injected by JS)
  - Email gate modal
  - Result container (injected by JS after quiz completes)
  - All CTA buttons editable from Theme Editor via schema settings
  - All settings passed to JS via data-* attributes on <section>

  Assets:
  - assets/shatokb-quiz.css
  - assets/shatokb-quiz.js
  ============================================================
{% endcomment %}

{{ 'shatokb-quiz.css' | asset_url | stylesheet_tag }}
{{ 'shatokb-koi-chat.css' | asset_url | stylesheet_tag }}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Arimo:wght@400;600&display=swap" rel="stylesheet">

<style>

  /* ══════════════════════════════════════════════
     BLOQUE COPY D — "Ese momento puede ser hoy"
     ══════════════════════════════════════════════ */

  /* Partículas flotantes de fondo */
  @keyframes stk-float-up {
    0%   { transform: translateY(0) scale(1);   opacity: 0.7; }
    100% { transform: translateY(-120px) scale(1.4); opacity: 0; }
  }
  @keyframes stk-shimmer {
    0%   { background-position: -400px 0; }
    100% { background-position: 400px 0; }
  }
  @keyframes stk-fade-up {
    0%   { opacity: 0; transform: translateY(28px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes stk-fade-up-delay {
    0%,40% { opacity: 0; transform: translateY(20px); }
    100%   { opacity: 1; transform: translateY(0); }
  }
  @keyframes stk-pulse-glow {
    0%,100% { box-shadow: 0 0 0 0 rgba(236,149,184,0); }
    50%     { box-shadow: 0 0 32px 8px rgba(236,149,184,0.22); }
  }
  @keyframes stk-line-grow {
    0%   { width: 0; opacity: 0; }
    100% { width: 64px; opacity: 1; }
  }
  @keyframes stk-spark {
    0%,100% { opacity:0; transform: scale(0.6) rotate(0deg); }
    50%     { opacity:1; transform: scale(1.2) rotate(180deg); }
  }
  @keyframes stk-border-spin {
    0%   { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
  @keyframes stk-counter {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Contenedor principal */
  .stk-hook-wrap {
    position: relative;
    max-width: 620px;
    margin: 0 auto 48px;
    padding: 0 16px;
    text-align: center;
  }

  /* Card con borde gradiente animado */
  .stk-hook-card {
    position: relative;
    background: linear-gradient(135deg, #fff8f5 0%, #fdf2f8 50%, #f9f5ff 100%);
    border-radius: 24px;
    padding: 44px 40px 38px;
    overflow: hidden;
    animation: stk-fade-up 0.8s cubic-bezier(0.22,1,0.36,1) both,
               stk-pulse-glow 4s ease-in-out 1s infinite;
    /* Borde gradiente animado via pseudo */
  }
  .stk-hook-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 2px;
    background: linear-gradient(135deg, #ec95b8, #c084fc, #818cf8, #ec95b8);
    background-size: 300% 300%;
    animation: stk-border-spin 4s linear infinite;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Destellos de fondo dentro de la card */
  .stk-hook-card::after {
    content: '';
    position: absolute;
    top: -60px; left: -60px;
    width: 220px; height: 220px;
    background: radial-gradient(circle, rgba(236,149,184,0.18) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    animation: stk-pulse-glow 3s ease-in-out infinite;
  }

  /* Partículas decorativas */
  .stk-hook-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: 24px;
  }
  .stk-hook-particles span {
    position: absolute;
    font-size: 14px;
    animation: stk-float-up 3.5s ease-in-out infinite;
    opacity: 0;
  }
  .stk-hook-particles span:nth-child(1) { left:8%;  bottom:10%; animation-delay:0s;    animation-duration:3.2s; font-size:12px; }
  .stk-hook-particles span:nth-child(2) { left:20%; bottom:5%;  animation-delay:0.7s;  animation-duration:4s;   font-size:10px; }
  .stk-hook-particles span:nth-child(3) { left:75%; bottom:8%;  animation-delay:1.4s;  animation-duration:3.5s; font-size:13px; }
  .stk-hook-particles span:nth-child(4) { left:88%; bottom:15%; animation-delay:2.1s;  animation-duration:3.8s; font-size:10px; }
  .stk-hook-particles span:nth-child(5) { left:50%; bottom:3%;  animation-delay:0.4s;  animation-duration:4.2s; font-size:11px; }

  /* Icono chispa superior */
  .stk-hook-spark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #ec95b8, #c084fc);
    border-radius: 50%;
    font-size: 24px;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    animation: stk-fade-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.2s both,
               stk-spark 2.5s ease-in-out 1s infinite;
    box-shadow: 0 8px 32px rgba(236,149,184,0.45);
  }

  /* Línea decorativa */
  .stk-hook-line {
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ec95b8, #c084fc, transparent);
    border-radius: 2px;
    margin: 0 auto 24px;
    animation: stk-line-grow 0.8s cubic-bezier(0.22,1,0.36,1) 0.5s both;
    position: relative;
    z-index: 1;
  }

  /* Texto principal */
  .stk-hook-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: #2d1b3d;
    line-height: 1.6;
    margin: 0 0 20px;
    position: relative;
    z-index: 1;
    animation: stk-fade-up 0.9s cubic-bezier(0.22,1,0.36,1) 0.35s both;
    letter-spacing: -0.01em;
  }
  .stk-hook-text em {
    font-style: normal;
    color: #9b59b6;
    font-weight: 700;
  }

  /* Frase remate — "Ese momento puede ser hoy." */
  .stk-hook-remate {
    display: inline-block;
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 26px;
    background: linear-gradient(135deg, #ec95b8 0%, #c084fc 50%, #818cf8 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: stk-fade-up-delay 1.2s cubic-bezier(0.22,1,0.36,1) both,
               stk-shimmer 3s linear 1.5s infinite;
    position: relative;
    z-index: 1;
    margin-bottom: 0;
  }

  /* Contador social proof */
  .stk-hook-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(236,149,184,0.3);
    border-radius: 50px;
    padding: 8px 18px;
    margin-top: 28px;
    font-family: 'Arimo', Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    position: relative;
    z-index: 1;
    animation: stk-counter 0.7s ease 1.4s both;
  }
  .stk-hook-social strong {
    color: #ec95b8;
    font-size: 13px;
  }
  .stk-hook-social-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
    animation: stk-spark 1.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .stk-hook-card    { padding: 36px 24px 30px; }
    .stk-hook-text    { font-size: 19px; }
    .stk-hook-remate  { font-size: 22px; }
  }

  /* ── Quiz section — override Halo html{font-size:62.5%} base 10px ── */
  .shatokb-quiz-section__titulo {
    font-family: 'Prompt', 'Arial Black', sans-serif !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    color: #0b0335 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.02em !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .shatokb-quiz-section__subtitulo {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 15px !important;
    color: #6b7280 !important;
    margin: 0 !important;
    line-height: 1.55 !important;
  }
  .shatokb-progreso__meta {
    font-family: 'Arimo', Arial, sans-serif !important;
    font-size: 14px !important;
    color: #6b7280 !important;
  }
  @media (max-width: 768px) {
    .shatokb-quiz-section__titulo { font-size: 22px !important; }
  }
</style>

{%- comment -%}
  All Theme Editor settings are passed to JS via data-* attributes.
  The JS reads them with shatokbGetConfig() → no hardcoded values in JS.
{%- endcomment -%}

<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-bestsellers-show="{{ section.settings.btn_bestsellers_show }}"
  data-btn-bestsellers-text="{{ section.settings.btn_bestsellers_text | escape }}"
  data-btn-bestsellers-url="{{ section.settings.btn_bestsellers_url }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    {%- comment -%} ── Hook copy D — "Ese momento puede ser hoy" ── {%- endcomment -%}
    <div class="stk-hook-wrap" id="stk-hook-block">

      <div class="stk-hook-card">

        <!-- Partículas flotantes -->
        <div class="stk-hook-particles" aria-hidden="true">
          <span>✨</span>
          <span>🌸</span>
          <span>✦</span>
          <span>✨</span>
          <span>🌸</span>
        </div>

        <!-- Icono principal -->
        <div class="stk-hook-spark" aria-hidden="true">✨</div>

        <!-- Línea decorativa -->
        <div class="stk-hook-line" aria-hidden="true"></div>

        <!-- Texto principal -->
        <p class="stk-hook-text">
          En algún momento dejarás de probar<br>
          productos <em>al azar</em><br>
          y empezarás con tu rutina exacta.
        </p>

        <!-- Remate emocional con gradiente animado -->
        <p class="stk-hook-remate">Ese momento puede ser hoy.</p>

        <!-- Social proof pill -->
        <div class="stk-hook-social" aria-label="Más de 50.000 rutinas personalizadas creadas">
          <span class="stk-hook-social-dot"></span>
          <span><strong>+50.000</strong> rutinas personalizadas creadas</span>
        </div>

      </div>
    </div>

    {%- comment -%} ── Section header ──────────────────────────── {%- endcomment -%}
    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      {%- comment -%} badge ocultado — emoji 🇰🇷 eliminado {%- endcomment -%}
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.subtitulo }}</p>
    </header>

    {%- comment -%} ── Quiz start screen ──────────────────────── {%- endcomment -%}
    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:15px; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 28px;">
        Most people spend years — and hundreds of dollars — trying random products that don't work for their skin.<br><br>
        <strong>This quiz ends that.</strong> In 2 minutes you'll know your exact skin profile and the Korean products proven to work for it.
      </p>
      <button
        id="shatokb-btn-inicio"
        style="display:inline-flex;align-items:center;justify-content:center;padding:15px 36px;background:#3a7af5;color:#fff;font-family:'Arimo',Arial,sans-serif;font-size:16px;font-weight:700;border:none;border-radius:6px;cursor:pointer;transition:background 0.2s;"
        type="button"
        onclick="event.stopPropagation();event.preventDefault();shatokbIniciarQuiz();return false;">
        Yes — show me my routine →
      </button>
      <p style="font-family:'Arimo',Arial,sans-serif; font-size:13px; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    {%- comment -%} ── Progress bar ────────────────────────────── {%- endcomment -%}
    <div
      id="shatokb-progreso"
      class="shatokb-progreso"
      style="display:none;"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 6</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    {%- comment -%} ── Quiz questions (injected by JS) ──────────── {%- endcomment -%}
    <div
      id="shatokb-quiz-form"
      class="shatokb-quiz-form"
      style="display:none;"
      aria-live="polite"
      aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

{%- comment -%} ── Email gate modal (outside section for z-index) ─ {%- endcomment -%}
<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop" onclick="shatokbSaltarEmail()"></div>
  <div class="stk-gate__card">
    <span class="stk-gate__emoji">🎁</span>
    <h2 class="stk-gate__title" id="stk-gate-title">Your routine is ready!</h2>
    <p class="stk-gate__sub">Where should we send it so you can come back to it anytime?</p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input
        type="email"
        id="stk-email-input"
        class="stk-gate__input"
        placeholder="your@email.com"
        required
        autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Show me my routine ✨
      </button>
    </form>
    <button class="stk-gate__skip" type="button" onclick="shatokbSaltarEmail()">
      No thanks, just show me the routine
    </button>
    <p class="stk-gate__privacy">🔒 No spam. No subscriptions. Just your routine.</p>
  </div>
</div>

{%- comment -%} ── Result container (injected by JS) ──────────────── {%- endcomment -%}
<div
  id="shatokb-resultado"
  class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite"
  aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

<script src="{{ 'shatokb-quiz.js' | asset_url }}" defer></script>
<script src="{{ 'shatokb-koi-chat.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "🔬 Skin Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [

    {
      "type": "header",
      "content": "📋 Section Header"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text (optional)",
      "default": "🇰🇷 Free · 2 minutes · Real K-Beauty products"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Section subtitle",
      "default": "2 minutes. 6 questions. A complete routine with real Korean products — chosen for your skin, your concerns and your budget. Free."
    },

    {
      "type": "header",
      "content": "🛍️ Button — Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "🛍️ Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link",
      "info": "e.g. /collections/all"
    },

    {
      "type": "header",
      "content": "💬 Button — WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
      "info": "Disabled — KOI AI replaces this button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_whatsapp_text",
      "label": "Button text",
      "default": "💬 Talk to a skin expert"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_number",
      "label": "WhatsApp number (with country code, no +)",
      "default": "12345678900",
      "info": "Example: 17865551234 (US) · 34612345678 (Spain)"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_message",
      "label": "Pre-written message",
      "default": "Hi! I just took the skin quiz and need help with my routine."
    },

    {
      "type": "header",
      "content": "⭐ Button — Best Sellers (Hero)"
    },
    {
      "type": "checkbox",
      "id": "btn_bestsellers_show",
      "label": "Show button in hero",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_bestsellers_text",
      "label": "Button text",
      "default": "⭐ View Best Sellers"
    },
    {
      "type": "url",
      "id": "btn_bestsellers_url",
      "label": "Button link",
      "info": "e.g. /collections/best-sellers"
    },

    {
      "type": "header",
      "content": "↺ Button — Retake Quiz"
    },
    {
      "type": "checkbox",
      "id": "btn_retake_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_retake_text",
      "label": "Button text",
      "default": "↺ My skin feels different — redo"
    },

    {
      "type": "header",
      "content": "🛒 Sticky Total Bar"
    },
    {
      "type": "text",
      "id": "total_bar_label",
      "label": "Bar label",
      "default": "Estimated total for your routine"
    },
    {
      "type": "text",
      "id": "total_bar_cta",
      "label": "Add to cart button text",
      "default": "🛒 Add my full routine to cart"
    }

  ],
  "presets": [
    {
      "name": "🔬 Skin Quiz"
    }
  ]
}
{% endschema %}
