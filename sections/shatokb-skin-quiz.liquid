{% comment %}
  ============================================================
  SHATOKB · Skin Diagnosis Quiz  v3.0
  File: sections/shatokb-skin-quiz.liquid
  ============================================================
{% endcomment %}

{{ 'shatokb-quiz.css' | asset_url | stylesheet_tag }}

<section
  id="shatokb-quiz"
  class="shatokb-quiz-section"
  aria-label="Personalized skin diagnosis quiz"

  data-btn-catalogue-show="{{ section.settings.btn_catalogue_show }}"
  data-btn-catalogue-text="{{ section.settings.btn_catalogue_text | escape }}"
  data-btn-catalogue-url="{{ section.settings.btn_catalogue_url }}"

  data-btn-whatsapp-show="{{ section.settings.btn_whatsapp_show }}"
  data-btn-whatsapp-text="{{ section.settings.btn_whatsapp_text | escape }}"
  data-btn-whatsapp-number="{{ section.settings.btn_whatsapp_number | escape }}"
  data-btn-whatsapp-message="{{ section.settings.btn_whatsapp_message | escape }}"

  data-btn-bestsellers-show="{{ section.settings.btn_bestsellers_show }}"
  data-btn-bestsellers-text="{{ section.settings.btn_bestsellers_text | escape }}"
  data-btn-bestsellers-url="{{ section.settings.btn_bestsellers_url }}"

  data-btn-retake-show="{{ section.settings.btn_retake_show }}"
  data-btn-retake-text="{{ section.settings.btn_retake_text | escape }}"

  data-total-bar-label="{{ section.settings.total_bar_label | escape }}"
  data-total-bar-cta="{{ section.settings.total_bar_cta | escape }}"
>
  <div class="shatokb-quiz-section__inner">

    <header class="shatokb-quiz-section__header" id="shatokb-quiz-cabecera">
      {%- if section.settings.badge != blank -%}
        <span class="shatokb-hero__badge" style="margin-bottom:16px; display:inline-block;">
          {{ section.settings.badge }}
        </span>
      {%- endif -%}
      <h2 class="shatokb-quiz-section__titulo">{{ section.settings.titulo }}</h2>
      <p class="shatokb-quiz-section__subtitulo">{{ section.settings.subtitulo }}</p>
    </header>

    <div id="shatokb-quiz-inicio" style="text-align:center; padding:12px 0 40px;">
      <div style="font-size:3.6rem; margin-bottom:20px; line-height:1;">🔬✨</div>
      <p style="font-size:1rem; color:#6b7280; line-height:1.65; max-width:480px; margin:0 auto 32px;">
        Most people spend years — and hundreds of dollars — trying random products that don't work for their skin.<br><br>
        <strong>This quiz ends that.</strong> In 2 minutes you'll know your exact skin profile and the Korean products proven to work for it.
      </p>
      <button
        class="shatokb-btn shatokb-btn--primary shatokb-btn--lg"
        type="button"
        onclick="shatokbIniciarQuiz()">
        Yes — show me my routine →
      </button>
      <p style="font-size:0.75rem; color:#9ca3af; margin-top:14px;">Free · No account needed · Results in 2 minutes</p>
    </div>

    <div
      id="shatokb-progreso"
      class="shatokb-progreso"
      style="display:none;"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0">
      <div class="shatokb-progreso__meta">
        <span id="shatokb-progreso-texto">Question 1 of 6</span>
        <span id="shatokb-pregunta-num" aria-hidden="true">0%</span>
      </div>
      <div class="shatokb-progreso__track">
        <div id="shatokb-progreso-barra" class="shatokb-progreso__fill" style="width:0%"></div>
      </div>
    </div>

    <div
      id="shatokb-quiz-form"
      class="shatokb-quiz-form"
      style="display:none;"
      aria-live="polite"
      aria-label="Quiz questions">
      <noscript>
        <p style="text-align:center; color:#f42b23; font-weight:600; padding:24px 0;">
          Please enable JavaScript to use the skin diagnosis quiz.
        </p>
      </noscript>
    </div>

  </div>
</section>

<div id="stk-email-gate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="stk-gate-title">
  <div class="stk-gate__backdrop" onclick="shatokbSaltarEmail()"></div>
  <div class="stk-gate__card">
    <span class="stk-gate__emoji">🎁</span>
    <h2 class="stk-gate__title" id="stk-gate-title">Your routine is ready!</h2>
    <p class="stk-gate__sub">Where should we send it so you can come back to it anytime?</p>
    <form class="stk-gate__form" onsubmit="shatokbSubmitEmail(event)">
      <input
        type="email"
        id="stk-email-input"
        class="stk-gate__input"
        placeholder="your@email.com"
        required
        autocomplete="email" />
      <button type="submit" class="stk-gate__btn" id="stk-gate-submit">
        Show me my routine ✨
      </button>
    </form>
    <button class="stk-gate__skip" type="button" onclick="shatokbSaltarEmail()">
      No thanks, just show me the routine
    </button>
    <p class="stk-gate__privacy">🔒 No spam. No subscriptions. Just your routine.</p>
  </div>
</div>

<div
  id="shatokb-resultado"
  class="shatokb-resultado"
  style="display:none; padding:0 24px 88px;"
  aria-live="polite"
  aria-label="Your skin diagnosis result">
  <div class="shatokb-resultado__inner"></div>
</div>

<script src="{{ 'shatokb-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "🔬 Skin Quiz",
  "tag": "section",
  "class": "shatokb-section",
  "settings": [
    {
      "type": "header",
      "content": "📋 Section Header"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text (optional)",
      "default": "🇰🇷 Free · 2 minutes · Real K-Beauty products"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Section title",
      "default": "Find out exactly what your skin needs."
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Section subtitle",
      "default": "2 minutes. 6 questions. A complete routine with real Korean products — chosen for your skin, your concerns and your budget. Free."
    },
    {
      "type": "header",
      "content": "🛍️ Button — Full Catalogue"
    },
    {
      "type": "checkbox",
      "id": "btn_catalogue_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_catalogue_text",
      "label": "Button text",
      "default": "🛍️ Explore the full catalogue"
    },
    {
      "type": "url",
      "id": "btn_catalogue_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "💬 Button — WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "btn_whatsapp_show",
      "label": "Show button",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_whatsapp_text",
      "label": "Button text",
      "default": "💬 Talk to a skin expert"
    },
    {
      "type": "text",
      "id": "btn_whatsapp_number",
      "label": "WhatsApp number (with country code, no +)",
      "default": ""
    },
    {
      "type": "text",
      "id": "btn_whatsapp_message",
      "label": "Pre-written message",
      "default": "Hi! I just took the skin quiz and need help with my routine."
    },
    {
      "type": "header",
      "content": "⭐ Button — Best Sellers"
    },
    {
      "type": "checkbox",
      "id": "btn_bestsellers_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_bestsellers_text",
      "label": "Button text",
      "default": "⭐ View Best Sellers"
    },
    {
      "type": "url",
      "id": "btn_bestsellers_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "↺ Button — Retake Quiz"
    },
    {
      "type": "checkbox",
      "id": "btn_retake_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_retake_text",
      "label": "Button text",
      "default": "↺ My skin feels different — redo"
    },
    {
      "type": "header",
      "content": "🛒 Sticky Total Bar"
    },
    {
      "type": "text",
      "id": "total_bar_label",
      "label": "Bar label",
      "default": "Estimated total for your routine"
    },
    {
      "type": "text",
      "id": "total_bar_cta",
      "label": "Add to cart button text",
      "default": "🛒 Add my full routine to cart"
    }
  ],
  "presets": [
    {
      "name": "🔬 Skin Quiz"
    }
  ]
}
{% endschema %}
